		height: 27px;

		font-size: 8px;
	}

	.feature-card-label {
		font-size: 8px;
	}

	.feature-card-media {
		height: 270px;
	}

	.feature-card-info {
		display: block;

		padding: 25px 22px 28px;
	}

	.feature-card-info h3 {
		font-size: 2rem;
	}

	.feature-card-info p {
		font-size: 13px;
		line-height: 1.75;
	}

	.feature-card-dots {
		margin-top: 25px;
	}

}

/* ===================================================== */
/* MOBILE PEQUEÑO */
/* ===================================================== */

@media (max-width: 640px) {

	.feature-section {
		padding: 80px 0 95px;
	}

	.feature-heading {
		margin-bottom: 55px;
	}

	.feature-heading h2 {
		font-size: 2.8rem;
	}

	.feature-list {
		gap: 75px;
	}

	.feature-media {
		height: 250px;
	}

	.feature-content h3 {
		font-size: 2.15rem;
	}

}
/* ===================================================== */
/* VIDEO */
/* ===================================================== */

.feature-media {
	position: relative;

	width: 100%;
	height: 430px;

	overflow: hidden;

	background:
		linear-gradient(
			135deg,
			#e9ebf3 0%,
			#f1f2f7 50%,
			#e5e8f1 100%
		);

	border-radius: 4px;
}


/* Rejilla muy sutil para que el espacio vacío no se vea muerto */

.feature-media::before {
	content: '';

	position: absolute;

	inset: 0;

	background:
		linear-gradient(
			90deg,
			transparent 49.9%,
			rgba(68,78,134,.045) 50%,
			transparent 50.1%
		),
		linear-gradient(
			0deg,
			transparent 49.9%,
			rgba(68,78,134,.045) 50%,
			transparent 50.1%
		);

	background-size: 70px 70px;

	opacity: .45;

	pointer-events: none;
}


/* Indicador temporal hasta que estén los videos */

.feature-media::after {
	content: 'VIDEO · PRÓXIMAMENTE';

	position: absolute;

	left: 28px;
	bottom: 24px;

	padding: 7px 11px;

	border: 1px solid rgba(68,78,134,.14);

	background: rgba(246,247,251,.72);

	color: #6f7590;

	font-size: 8px;
	font-weight: 700;

	letter-spacing: .16em;

	backdrop-filter: blur(8px);
}


/* Cuando agreguemos los videos */

.feature-media video {
	display: block;

	width: 100%;
	height: 100%;

	object-fit: cover;
}


/* ===================================================== */
/* CONTENIDO */
/* ===================================================== */

.feature-content {
	padding: 10px 0;
}


/* ===================================================== */
/* NÚMERO */
/* ===================================================== */

.feature-number {
	display: flex;
	align-items: center;
	gap: 12px;

	margin-bottom: 24px;

	color: #444e86;

	font-size: 10px;
	font-weight: 700;

	letter-spacing: .2em;
}


/* Línea decorativa */

.feature-number::after {
	content: '';

	display: block;

	width: 42px;
	height: 1px;

	background: rgba(68,78,134,.3);
}


/* ===================================================== */
/* TÍTULO */
/* ===================================================== */

.feature-content h3 {
	max-width: 520px;

	margin: 0 0 26px;

	color: #14152a;

	font-family:
		'HarmonyOS Sans SC',
		'HarmonyOS Sans',
		Arial,
		sans-serif;

	font-size: clamp(2rem, 3.5vw, 3.5rem);

	font-weight: 700;

	line-height: 1.02;

	letter-spacing: -.045em;
}


/* ===================================================== */
/* DESCRIPCIÓN */
/* ===================================================== */

.feature-content p {
	max-width: 520px;

	margin: 0;

	color: #5c6079;

	font-size: 14px;

	line-height: 1.85;
}


/* ===================================================== */
/* NOTA DE SEGURIDAD */
/* ===================================================== */

.feature-note {
	display: block;

	max-width: 500px;

	margin-top: 24px;
	padding-top: 16px;

	border-top: 1px solid rgba(68,78,134,.12);

	color: #8a90a5;

	font-size: 9px;

	line-height: 1.6;
}


/* ===================================================== */
/* TABLET */
/* ===================================================== */

@media (max-width: 1000px) {

	.feature-list {
		gap: 110px;
	}

	.feature-block,
	.feature-block-reverse {
		grid-template-columns: 1fr 1fr;

		gap: 50px;
	}

	.feature-media {
		height: 350px;
	}

	.feature-content h3 {
		font-size: clamp(2rem, 4vw, 3rem);
	}

}


/* ===================================================== */
/* MOBILE */
/* ===================================================== */

@media (max-width: 768px) {

	.feature-section {
		padding: 90px 0 110px;
	}

	.feature-section .section-heading-row h2 {
		font-size: clamp(2.6rem, 10vw, 4rem);
	}

	.feature-list {
		gap: 90px;

		margin-top: 60px;
	}

	.feature-block,
	.feature-block-reverse {
		display: flex;
		flex-direction: column;

		gap: 32px;
	}

	.feature-block-reverse .feature-media,
	.feature-block-reverse .feature-content {
		order: initial;
	}

	.feature-media {
		height: 320px;
	}

	.feature-content {
		width: 100%;
	}

	.feature-content h3 {
		max-width: 600px;

		font-size: 2.4rem;
	}

	.feature-content p {
		max-width: 600px;

		font-size: 13px;
	}

}


/* ===================================================== */
/* MOBILE PEQUEÑO */
/* ===================================================== */

@media (max-width: 640px) {

	.feature-section {
		padding: 80px 0 90px;
	}

	.feature-list {
		gap: 75px;

		margin-top: 50px;
	}

	.feature-media {
		height: 250px;
	}

	.feature-media::after {
		left: 16px;
		bottom: 16px;

		font-size: 7px;
	}

	.feature-content h3 {
		font-size: 2rem;
	}

	.feature-content p {
		font-size: 13px;

		line-height: 1.75;
	}

}
/* ===================================================== */
/* VIDEO */
/* ===================================================== */

.video-section {
	padding: 120px 0;
	background: #f6f7fb;
}

.video-header {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 50px;
	margin-bottom: 45px;
}

.video-header > p {
	max-width: 360px;
	margin: 0;
	color: #5c6079;
	line-height: 1.7;
}

.video-container {
	height: 560px;
	border-radius: 30px;
	border: 1px solid var(--line);
	overflow: hidden;
	background: #eef0f6;
}

.video-player {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	background: #eef0f6;
}


/* ===================================================== */
/* KIT */
/* ===================================================== */

.kit-section {
	padding: 130px 0;
	background: #eef0f6;
}

.section-heading-centered {
	text-align: center;
	max-width: 800px;
	margin: 0 auto 70px;
}

.section-heading-centered h2 {
	margin: 18px 0 0;
	font-size: clamp(2.7rem, 5vw, 5.5rem);
	line-height: .95;
	letter-spacing: -.05em;
}

.section-heading-centered h2 span {
	display: block;
	color: #444e86;
}

.kit-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 14px;
}

.kit-card {
	position: relative;
	padding: 20px;
	border: 1px solid var(--line);
	border-radius: 22px;
	background: #ffffff;
	overflow: hidden;

	transition:
		transform .35s ease,
		box-shadow .35s ease,
		border-color .35s ease;
}

.kit-image-placeholder {
	height: 180px;
	margin: 18px 0;
	padding: 14px;
	border-radius: 16px;
	border: 1px dashed rgba(68,78,134,.2);
	background:
		radial-gradient(
			circle at center,
			rgba(68,78,134,.07),
			transparent 50%
		);
	background-color: #e0dede;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	color: #8288a0;
	overflow: hidden;

	transition:
		border-color .35s ease,
		background .35s ease;
}

.kit-image-placeholder img {
	width: 100%;
	height: 100%;
	object-fit: contain;
	border-radius: 8px;

	transition:
		transform .5s ease;
}

.kit-card:hover .kit-image-placeholder img {
	transform: scale(1.045);
}

.kit-image-placeholder div {
	font-size: 34px;
	font-weight: 200;
	color: var(--accent);
}

.kit-image-placeholder span {
	margin-top: 10px;
	font-size: 8px;
	letter-spacing: .2em;
}

.kit-card h3 {
	margin: 0;
	font-family: 'Syne', sans-serif;
	font-size: 19px;
	color: #14152a;

	transition:
		color .35s ease;
}

.kit-card:hover h3 {
	color: #444e86;
}

.kit-card p {
	margin: 7px 0 0;
	color: #5c6079;
	font-size: 12px;
	line-height: 1.6;
}

/* ===================================================== */
/* ESPECIFICACIONES */
/* ===================================================== */

.specifications-section {
	padding: 100px 0;
	background:
		linear-gradient(
			180deg,
			#f6f7fb 0%,
			#eef0f6 100%
		);
}

/* ===================================================== */
/* ENCABEZADO */
/* ===================================================== */

.spec-heading {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 70px;
	align-items: end;
	margin-bottom: 48px;
}

.spec-heading h2 {
	margin: 15px 0 0;
	max-width: 620px;

	font-size: clamp(2.5rem, 4vw, 4.3rem);
	line-height: .94;
	letter-spacing: -.055em;

	color: #14152a;
}

.spec-heading h2 span {
	display: block;
	color: #444e86;
}

.spec-heading > p {
	color: #5c6079;
	font-size: 14px;
	line-height: 1.75;
	max-width: 460px;
	margin-bottom: 4px;
}

/* ===================================================== */
/* GRID DE ESPECIFICACIONES */
/* ===================================================== */

.big-spec-grid {
	display: grid;
	grid-template-columns: 2fr 1fr 1fr;
	gap: 7px;

	border: 1px solid rgba(68, 78, 134, .18);
	border-radius: 28px;

	overflow: hidden;

	background: #343d73;

	box-shadow:
		0 22px 55px rgba(23, 26, 60, .12);
}

/* ===================================================== */
/* TARJETAS */
/* ===================================================== */

.big-spec {
	position: relative;

	min-height: 125px;
	padding: 27px 30px;

	background:
		linear-gradient(
			135deg,
			#444e86 0%,
			#3d477e 100%
		);

	border: 1px solid rgba(255, 255, 255, .08);

	overflow: hidden;

	transition:
		transform .35s ease,
		background .35s ease,
		border-color .35s ease,
		box-shadow .35s ease;
}

/* ===================================================== */
/* DETALLE DECORATIVO */
/* ===================================================== */

.big-spec::after {
	content: '';

	position: absolute;

	width: 150px;
	height: 150px;

	right: -65px;
	bottom: -75px;

	border-radius: 50%;

	background:
		radial-gradient(
			circle,
			rgba(255, 255, 255, .14) 0%,
			rgba(255, 255, 255, .04) 45%,
			transparent 70%
		);

	opacity: .55;

	transform: scale(.75);

	transition:
		opacity .35s ease,
		transform .35s ease;
}

/* ===================================================== */
/* BRILLO SUAVE AL PASAR EL CURSOR */
/* ===================================================== */

.big-spec::before {
	content: '';

	position: absolute;

	inset: 0;

	background:
		linear-gradient(
			120deg,
			transparent 20%,
			rgba(255, 255, 255, .08) 50%,
			transparent 80%
		);

	transform: translateX(-100%);

	transition: transform .65s ease;

	pointer-events: none;
}

/* ===================================================== */
/* HOVER */
/* ===================================================== */

.big-spec:hover {
	transform: translateY(-4px);

	background:
		linear-gradient(
			135deg,
			#4d5895 0%,
			#444e86 100%
		);

	border-color: rgba(255, 255, 255, .18);

	box-shadow:
		0 16px 35px rgba(52, 61, 115, .22);

	z-index: 2;
}

.big-spec:hover::after {
	opacity: 1;
	transform: scale(1);
}

.big-spec:hover::before {
	transform: translateX(100%);
}

/* ===================================================== */
/* TARJETA DESTACADA */
/* ===================================================== */

.big-spec.featured {
	grid-column: span 2;

	background:
		radial-gradient(
			circle at 18% 25%,
			rgba(158, 169, 225, .24),
			transparent 48%
		),
		linear-gradient(
			135deg,
			#343d73 0%,
			#444e86 100%
		);

	border-color: rgba(255, 255, 255, .10);
}

.big-spec.featured:hover {
	background:
		radial-gradient(
			circle at 18% 25%,
			rgba(158, 169, 225, .30),
			transparent 52%
		),
		linear-gradient(
			135deg,
			#3b4580 0%,
			#4d5895 100%
		);
}

/* ===================================================== */
/* VALORES */
/* ===================================================== */

.spec-value {
	position: relative;
	z-index: 1;

	font-family: 'Syne', sans-serif;

	font-size: clamp(1.9rem, 3vw, 3rem);
	line-height: 1;

	font-weight: 800;

	color: #ffffff;

	letter-spacing: -.04em;

	transition:
		color .35s ease,
		transform .35s ease;
}

.big-spec:hover .spec-value {
	color: #ffffff;
	transform: translateX(3px);
}

/* ===================================================== */
/* ETIQUETAS */
/* ===================================================== */

.spec-label {
	position: relative;
	z-index: 1;

	display: inline-flex;

	margin-top: 14px;

	padding: 6px 10px;

	border-radius: 999px;

	background: rgba(255, 255, 255, .10);

	color: #cbd2f0;

	font-size: 8px;

	letter-spacing: .16em;

	transition:
		background .35s ease,
		color .35s ease,
		transform .35s ease;
}

.big-spec:hover .spec-label {
	background: rgba(255, 255, 255, .16);

	color: #ffffff;

	transform: translateY(-1px);
}

/* ===================================================== */
/* RESPONSIVE */
/* ===================================================== */

@media (max-width: 900px) {

	.spec-heading {
		grid-template-columns: 1fr;
		gap: 25px;
		margin-bottom: 40px;
	}

	.spec-heading > p {
		max-width: 600px;
	}

	.big-spec-grid {
		grid-template-columns: 1fr 1fr;
	}

	.big-spec.featured {
		grid-column: span 2;
	}

	.kit-grid {
		grid-template-columns: repeat(2, 1fr);
	}

	.kit-card.wide {
		grid-column: span 2;
	}

}

@media (max-width: 600px) {

	.specifications-section {
		padding: 80px 0;
	}

	.spec-heading h2 {
		font-size: clamp(2.4rem, 11vw, 3.5rem);
	}

	.big-spec-grid {
		grid-template-columns: 1fr;
		gap: 6px;
		border-radius: 22px;
	}

	.big-spec,
	.big-spec.featured {
		grid-column: span 1;
		min-height: 120px;
		padding: 24px;
	}

	.spec-value {
		font-size: 2rem;
	}

}
/* ===================================================== */
/* NAVEGACIÓN */
/* ===================================================== */

.navigation-module {
	display: grid;
	grid-template-columns: 1fr 280px;

	margin-top: 70px;

	border: 1px solid rgba(68, 78, 134, .16);
	border-radius: 28px;

	overflow: hidden;

	background:
		linear-gradient(
			135deg,
			#f3f4f9 0%,
			#eef0f6 55%,
			#e9ebf3 100%
		);

	box-shadow:
		0 20px 55px rgba(23, 26, 60, .07);

	transition:
		box-shadow .4s ease,
		transform .4s ease;
}

.navigation-module:hover {
	box-shadow:
		0 28px 70px rgba(68, 78, 134, .12);
}


/* ===================================================== */
/* CONTENIDO PRINCIPAL */
/* ===================================================== */

.navigation-main {
	position: relative;

	padding: 48px 50px;

	overflow: hidden;
}

/* Detalle de luz */

.navigation-main::before {
	content: '';

	position: absolute;

	width: 300px;
	height: 300px;

	left: -120px;
	top: -150px;

	border-radius: 50%;

	background:
		radial-gradient(
			circle,
			rgba(68, 78, 134, .13) 0%,
			rgba(68, 78, 134, 0) 70%
		);

	pointer-events: none;
}


/* ===================================================== */
/* TITULO */
/* ===================================================== */

.navigation-main h3 {
	position: relative;

	margin: 16px 0 16px;

	font-family: 'Syne', sans-serif;

	font-size: clamp(1.9rem, 3.2vw, 3rem);

	line-height: 1.02;

	letter-spacing: -.045em;

	color: #14152a;

	max-width: 700px;
}


/* ===================================================== */
/* DESCRIPCIÓN */
/* ===================================================== */

.navigation-main > p {
	position: relative;

	max-width: 680px;

	margin: 0;

	color: #5c6079;

	font-size: 14px;

	line-height: 1.75;
}


/* ===================================================== */
/* PILLS */
/* ===================================================== */

.navigation-pills {
	position: relative;

	display: flex;

	flex-wrap: wrap;

	gap: 10px;

	margin-top: 32px;

	padding-top: 25px;

	border-top: 1px solid rgba(68, 78, 134, .12);
}


.navigation-pills > div {
	position: relative;

	padding: 13px 16px;

	border: 1px solid rgba(68, 78, 134, .13);

	border-radius: 14px;

	background: rgba(255,255,255,.65);

	box-shadow:
		0 5px 15px rgba(23, 26, 60, .025);

	transition:
		transform .3s ease,
		background .3s ease,
		border-color .3s ease,
		box-shadow .3s ease;
}


/* ===================================================== */
/* HOVER PILLS */
/* ===================================================== */

.navigation-pills > div:hover {
	transform: translateY(-4px);

	background: #ffffff;

	border-color: rgba(68, 78, 134, .28);

	box-shadow:
		0 12px 25px rgba(68, 78, 134, .10);
}


.navigation-pills strong,
.navigation-pills span {
	display: block;
}


/* Título de cada pill */

.navigation-pills strong {
	font-family: 'Syne', sans-serif;

	font-size: 13px;

	color: #14152a;

	transition:
		color .3s ease;
}


.navigation-pills > div:hover strong {
	color: #444e86;
}


/* Texto pequeño */

.navigation-pills span {
	margin-top: 5px;

	color: #777d99;

	font-size: 8px;

	text-transform: uppercase;

	letter-spacing: .08em;
}


/* ===================================================== */
/* LISTA LATERAL */
/* ===================================================== */

.navigation-list {
	border-left: 1px solid rgba(68, 78, 134, .12);

	background: rgba(255,255,255,.28);
}


/* ===================================================== */
/* ITEMS */
/* ===================================================== */

.navigation-item {
	position: relative;

	min-height: 88px;

	padding: 18px 17px;

	display: flex;

	gap: 12px;

	align-items: flex-start;

	border-bottom: 1px solid rgba(68, 78, 134, .10);

	color: #6b7088;

	background: transparent;

	transition:
		background .3s ease,
		color .3s ease,
		padding-left .3s ease;
}


.navigation-item:last-child {
	border-bottom: 0;
}


/* ===================================================== */
/* EFECTO LATERAL DEL HOVER */
/* ===================================================== */

.navigation-item::before {
	content: '';

	position: absolute;

	left: 0;
	top: 0;
	bottom: 0;

	width: 3px;

	background: #444e86;

	transform: scaleY(0);

	transform-origin: center;

	transition:
		transform .3s ease;
}


.navigation-item:hover::before,
.navigation-item.active::before {
	transform: scaleY(1);
}


/* ===================================================== */
/* HOVER ITEM */
/* ===================================================== */

.navigation-item:hover {
	background: rgba(68,78,134,.055);

	color: #14152a;

	padding-left: 21px;
}


/* ===================================================== */
/* ITEM ACTIVO */
/* ===================================================== */

.navigation-item.active {
	background:
		linear-gradient(
			90deg,
			rgba(68,78,134,.10),
			rgba(68,78,134,.035)
		);

	color: #14152a;
}


/* ===================================================== */
/* NUMERACIÓN */
/* ===================================================== */

.navigation-item > span {
	width: 24px;
	height: 24px;

	border: 1px solid rgba(68,78,134,.18);

	border-radius: 50%;

	display: flex;

	align-items: center;
	justify-content: center;

	flex-shrink: 0;

	font-size: 9px;

	color: #6f7590;

	background: rgba(255,255,255,.4);

	transition:
		background .3s ease,
		border-color .3s ease,
		color .3s ease,
		transform .3s ease;
}


.navigation-item:hover > span,
.navigation-item.active > span {
	background: #444e86;

	border-color: #444e86;

	color: #ffffff;

	transform: scale(1.08);
}


/* ===================================================== */
/* TITULO ITEM */
/* ===================================================== */

.navigation-item strong {
	font-size: 11px;

	font-weight: 600;

	line-height: 1.35;

	color: inherit;
}


/* ===================================================== */
/* DESCRIPCIÓN ITEM */
/* ===================================================== */

.navigation-item p {
	margin: 5px 0 0;

	font-size: 10px;

	line-height: 1.5;

	color: #6f748b;
}


/* ===================================================== */
/* HOVER DESCRIPCIÓN */
/* ===================================================== */

.navigation-item:hover p {
	color: #5c6079;
}


/* ===================================================== */
/* RESPONSIVE */
/* ===================================================== */

@media (max-width: 900px) {

	.navigation-module {
		grid-template-columns: 1fr;
	}

	.navigation-main {
		padding: 40px 30px;
	}

	.navigation-list {
		border-left: 0;

		border-top: 1px solid rgba(68, 78, 134, .12);

		display: grid;

		grid-template-columns: 1fr 1fr;
	}

	.navigation-item {
		min-height: 80px;

		border-right: 1px solid rgba(68, 78, 134, .10);
	}

	.navigation-item:nth-child(2n) {
		border-right: 0;
	}

	.navigation-item:nth-last-child(-n + 2) {
		border-bottom: 0;
	}
}


@media (max-width: 600px) {

	.navigation-module {
		margin-top: 50px;

		border-radius: 22px;
	}

	.navigation-main {
		padding: 34px 24px;
	}

	.navigation-main h3 {
		font-size: 2rem;
	}

	.navigation-main > p {
		font-size: 13px;
	}

	.navigation-pills {
		flex-direction: column;
	}

	.navigation-pills > div {
		width: 100%;
	}

	.navigation-list {
		grid-template-columns: 1fr;
	}

	.navigation-item {
		border-right: 0;

		min-height: 75px;
	}

	.navigation-item:nth-child(2n) {
		border-right: 0;
	}

	.navigation-item:nth-last-child(-n + 2) {
		border-bottom: 1px solid rgba(68, 78, 134, .10);
	}

	.navigation-item:last-child {
		border-bottom: 0;
	}
}

/* ===================================================== */
/* TABLA */
/* ===================================================== */

.detailed-title {
	margin: 58px 0 18px;

	color: #444e86;

	font-size: 10px;

	font-weight: 700;

	letter-spacing: .24em;

	line-height: 1;

	text-transform: uppercase;
}


/* ===================================================== */
/* CONTENEDOR PRINCIPAL */
/* ===================================================== */

.technical-table {
	position: relative;

	border: 1px solid rgba(68, 78, 134, .16);

	border-radius: 24px;

	overflow: hidden;

	background:
		linear-gradient(
			135deg,
			#f5f6fa 0%,
			#eef0f6 55%,
			#e9ebf3 100%
		);

	box-shadow:
		0 20px 55px rgba(23, 26, 60, .07);

	transition:
		border-color .35s ease,
		box-shadow .35s ease;
}

.technical-table:hover {
	border-color: rgba(68, 78, 134, .25);

	box-shadow:
		0 25px 65px rgba(68, 78, 134, .11);
}


/* ===================================================== */
/* BARRA SUPERIOR */
/* ===================================================== */

.technical-tabs {
	display: flex;

	gap: 5px;

	overflow-x: auto;

	padding: 8px;

	border-bottom: 1px solid rgba(68, 78, 134, .11);

	background:
		linear-gradient(
			180deg,
			rgba(255,255,255,.58),
			rgba(255,255,255,.28)
		);

	scrollbar-width: none;
}

.technical-tabs::-webkit-scrollbar {
	display: none;
}


/* ===================================================== */
/* TABS */
/* ===================================================== */

.technical-tabs span {
	position: relative;

	flex: 0 0 auto;

	padding: 11px 15px;

	border-radius: 9px;

	color: #666c86;

	font-size: 9px;

	font-weight: 500;

	white-space: nowrap;

	cursor: pointer;

	transition:
		color .3s ease,
		background .3s ease,
		transform .3s ease;
}

.technical-row-empty span {
	color: #8a90ab;
	font-style: italic;
}


/* Línea inferior */

.technical-tabs span::after {
	content: '';

	position: absolute;

	left: 15px;
	right: 15px;
	bottom: 4px;

	height: 2px;

	border-radius: 999px;

	background: #444e86;

	transform: scaleX(0);

	transform-origin: center;

	transition:
		transform .3s ease;
}


/* Hover */

.technical-tabs span:hover {
	color: #444e86;

	background: rgba(68,78,134,.055);

	transform: translateY(-1px);
}

.technical-tabs span:hover::after {
	transform: scaleX(.65);
}


/* Activo */

.technical-tabs span.active {
	background:
		linear-gradient(
			135deg,
			rgba(68,78,134,.12),
			rgba(68,78,134,.055)
		);

	color: #444e86;

	font-weight: 600;
}

.technical-tabs span.active::after {
	transform: scaleX(1);
}


/* ===================================================== */
/* FILAS */
/* ===================================================== */

.technical-row {
	position: relative;

	min-height: 64px;

	padding: 0 28px;

	display: flex;

	align-items: center;

	justify-content: space-between;

	gap: 30px;

	border-bottom: 1px solid rgba(68,78,134,.09);

	background: transparent;

	transition:
		background .3s ease,
		padding-left .3s ease,
		padding-right .3s ease;
}

.technical-row:last-child {
	border-bottom: 0;
}


/* ===================================================== */
/* INDICADOR LATERAL */
/* ===================================================== */

.technical-row::before {
	content: '';

	position: absolute;

	left: 0;

	top: 50%;

	width: 3px;

	height: 0;

	border-radius: 0 4px 4px 0;

	background: #444e86;

	transform: translateY(-50%);

	transition:
		height .3s ease;
}

.technical-row:hover::before {
	height: 28px;
}


/* ===================================================== */
/* HOVER FILA */
/* ===================================================== */

.technical-row:hover {
	background:
		linear-gradient(
			90deg,
			rgba(255,255,255,.58),
			rgba(255,255,255,.18)
		);

	padding-left: 33px;

	padding-right: 33px;
}


/* ===================================================== */
/* NOMBRE DEL DATO */
/* ===================================================== */

.technical-row span {
	color: #555b75;

	font-size: 12px;

	font-weight: 500;

	line-height: 1.4;

	transition:
		color .3s ease,
		transform .3s ease;
}

.technical-row:hover span {
	color: #444e86;

	transform: translateX(2px);
}


/* ===================================================== */
/* VALOR */
/* ===================================================== */

.technical-row strong {
	color: #14152a;

	font-family:
		'HarmonyOS Sans',
		'HarmonyOS Sans SC',
		Arial,
		sans-serif;

	font-size: 12px;

	font-weight: 600;

	letter-spacing: 0;

	line-height: 1.4;

	text-align: right;

	flex: 0 1 65%;
	max-width: 65%;

	transition:
		color .3s ease,
		transform .3s ease;
}

.technical-row:hover strong {
	color: #444e86;

	transform: translateX(-3px);
}


/* ===================================================== */
/* RESPONSIVE */
/* ===================================================== */

@media (max-width: 800px) {

	.detailed-title {
		margin-top: 48px;

		font-size: 9px;
	}

	.technical-table {
		border-radius: 20px;
	}

	.technical-tabs span {
		padding: 10px 13px;

		font-size: 8px;
	}

	.technical-row {
		min-height: 60px;

		padding: 0 20px;

		gap: 18px;
	}

	.technical-row:hover {
		padding-left: 25px;

		padding-right: 25px;
	}

	.technical-row span {
		font-size: 11px;
	}

	.technical-row strong {
    font-size: 11px;
    max-width: 62%;
}
}


@media (max-width: 520px) {

	.detailed-title {
		margin-top: 42px;

		margin-bottom: 15px;
	}

	.technical-tabs {
		padding: 6px;
	}

	.technical-tabs span {
		padding: 9px 11px;

		font-size: 8px;
	}

	.technical-row {
		min-height: 57px;

		padding: 0 16px;

		gap: 12px;
	}

	.technical-row:hover {
		padding-left: 20px;

		padding-right: 20px;
	}

	.technical-row span {
		font-size: 10px;
	}

.technical-row strong {
    font-size: 10px;
    max-width: 60%;
}
}

/* ===================================================== */
/* COMPARACIÓN */
/* ===================================================== */

.comparison-section {
	padding: 105px 0;
	background:
		linear-gradient(
			180deg,
			#f6f7fb 0%,
			#eef0f6 100%
		);
}

/* ===================================================== */
/* ENCABEZADO */
/* ===================================================== */

.center-heading {
	text-align: center;
	max-width: 760px;
	margin: 0 auto;
}

.center-heading h2 {
	margin: 16px 0 0;

	font-size: clamp(2.8rem, 5vw, 4.8rem);
	line-height: .9;
	letter-spacing: -.055em;

	color: #14152a;
}

.center-heading h2 span {
	display: block;
	color: #444e86;
}

/* ===================================================== */
/* CONTENEDOR */
/* ===================================================== */

.comparison {
	max-width: 920px;
	margin: 52px auto 0;

	border: 1px solid rgba(68,78,134,.14);
	border-radius: 28px;

	overflow: hidden;

	background: rgba(255,255,255,.72);

	box-shadow:
		0 25px 70px rgba(23,26,60,.08);

	backdrop-filter: blur(10px);
}

/* ===================================================== */
/* CABECERA DE MODELOS */
/* ===================================================== */

.comparison-header {
	display: grid;
	grid-template-columns: 1fr 1fr;

	background: #ffffff;

	border-bottom: 1px solid rgba(68,78,134,.12);
}

/* ===================================================== */
/* MODELO */
/* ===================================================== */

.comparison-model {
	position: relative;

	padding: 30px 32px 45px;

	text-align: center;

	border-right: 1px solid rgba(68,78,134,.10);

	transition:
		background .35s ease,
		transform .35s ease,
		box-shadow .35s ease;
}

.comparison-model:last-child {
	border-right: 0;
}

/* ===================================================== */
/* EAV-J100 — SIN STOCK */
/* ===================================================== */

.comparison-model.muted {
	background:
		linear-gradient(
			145deg,
			#f4f5f9 0%,
			#eceef4 100%
		);

	opacity: .72;
}

.comparison-model.muted::after {
	content: 'NO DISPONIBLE';

	position: absolute;

	bottom: 18px;
	right: 18px;

	padding: 6px 9px;

	border-radius: 999px;

	background: rgba(92,96,121,.08);
	border: 1px solid rgba(92,96,121,.10);

	color: #2a2f4b;

	font-size: 8px;
	font-weight: 700;

	letter-spacing: .14em;
}
/* ===================================================== */
/* J150 — PRODUCTO DESTACADO */
/* ===================================================== */

.comparison-model.featured::after {
	content: 'NUEVO';

	position: absolute;

	bottom: 18px;
	left: 18px;

	padding: 6px 9px;

	border-radius: 999px;

	background: rgba(68,78,134,.10);

	color: #444e86;

	font-size: 8px;
	font-weight: 700;

	letter-spacing: .14em;
}
/* ===================================================== */
/* IMAGEN */
/* ===================================================== */

.comparison-image {
	height: 110px;
	margin-bottom: 18px;

	display: flex;
	align-items: center;
	justify-content: center;
}

.comparison-placeholder {
	width: 100%;
	height: 100%;

	display: flex;
	align-items: center;
	justify-content: center;

	border: 1px dashed rgba(68,78,134,.16);
	border-radius: 18px;

	background:
		radial-gradient(
			circle at center,
			rgba(68,78,134,.06),
			transparent 65%
		);

	color: #9da3bd;

	font-size: 22px;

	transition:
		transform .35s ease,
		border-color .35s ease,
		background .35s ease;
}

.comparison-model:hover .comparison-placeholder {
	transform: scale(1.015);

	border-color: rgba(68,78,134,.28);

	background:
		radial-gradient(
			circle at center,
			rgba(68,78,134,.10),
			transparent 68%
		);
}

/* ===================================================== */
/* NOMBRE DEL MODELO */
/* ===================================================== */

.comparison-model > span {
	display: block;

	color: #737890;

	font-size: 9px;
	font-weight: 600;

	letter-spacing: .17em;
}

.comparison-model strong {
	display: block;

	margin-top: 7px;

	font-family: 'Syne', sans-serif;

	font-size: 24px;
	line-height: 1;

	color: #14152a;

	letter-spacing: -.035em;

	transition:
		color .3s ease,
		transform .3s ease;
}

.comparison-model.featured strong {
	color: #444e86;
}

.comparison-model:hover strong {
	transform: translateY(-2px);
}

/* ===================================================== */
/* FILAS DE COMPARACIÓN */
/* ===================================================== */

.comparison-row {
	display: grid;

	grid-template-columns: 1fr 150px 1fr;

	align-items: stretch;

	min-height: 68px;

	border-top: none;

	background: rgba(255,255,255,.62);

	transition:
		background .3s ease;
}

.comparison-row:hover {
	background: #ffffff;
}

/* ===================================================== */
/* VALOR ANTERIOR */
/* ===================================================== */

.old-value {
	display: flex;
	align-items: center;
	justify-content: flex-end;

	padding: 16px 24px;

	color: #9aa0b7;

	font-family: monospace;
	font-size: 13px;

	text-align: right;

	transition:
		color .3s ease;
}

.comparison-row:hover .old-value {
	color: #737890;
}

/* ===================================================== */
/* VALOR J150 */
/* ===================================================== */

.new-value {
	position: relative;

	display: flex;
	align-items: center;

	padding: 16px 24px;

	color: #444e86;

	font-family: monospace;
	font-size: 14px;
	font-weight: 700;

	transition:
		color .3s ease,
		transform .3s ease;
}

.comparison-row:hover .new-value {
	color: #344071;
	transform: translateX(3px);
}

/* Pequeña línea de énfasis */

.new-value::after {
	content: '';

	position: absolute;

	left: 24px;
	right: 24px;
	bottom: 8px;

	height: 2px;

	border-radius: 999px;

	background: rgba(68,78,134,.14);

	transform: scaleX(0);
	transform-origin: left;

	transition:
		transform .35s ease;
}

.comparison-row:hover .new-value::after {
	transform: scaleX(1);
}

/* ===================================================== */
/* ETIQUETA CENTRAL */
/* ===================================================== */

.comparison-label {
	height: 100%;

	display: flex;
	align-items: center;
	justify-content: center;

	padding: 12px 10px;

	border-inline:
		border-inline: none;

	color: #5c6079;

	font-size: 8px;
	font-weight: 600;

	line-height: 1.45;

	text-align: center;

	letter-spacing: .13em;

	transition:
		color .3s ease,
		background .3s ease;
}

.comparison-row:hover .comparison-label {
	color: #444e86;
	background: rgba(68,78,134,.025);
}

/* ===================================================== */
/* RESPONSIVE */
/* ===================================================== */

@media (max-width: 768px) {

	.comparison-section {
		padding: 80px 0;
	}

	.center-heading h2 {
		font-size: clamp(2.6rem, 10vw, 4rem);
	}

	.comparison {
		margin-top: 38px;
		border-radius: 22px;
	}

	.comparison-model {
	padding: 25px 18px 38px;
}
	.comparison-image {
		height: 90px;
	}

	.comparison-row {
		grid-template-columns: 1fr 105px 1fr;
		min-height: 62px;
	}

	.old-value,
	.new-value {
		padding: 14px 12px;
		font-size: 11px;
	}

	.comparison-label {
		font-size: 7px;
		padding: 10px 5px;
	}
	.comparison-note {
	padding: 10px 18px;

	border-top: 1px solid rgba(68,78,134,.10);

	color: #8a90a5;

	background: rgba(255,255,255,.35);

	font-size: 8px;
	line-height: 1.5;

	text-align: center;
}

.comparison-note strong {
	color: #5c6079;
}
}

@media (max-width: 520px) {

	.comparison-header {
		grid-template-columns: 1fr 1fr;
	}

	.comparison-model {
	padding: 20px 10px 35px;
}

	.comparison-image {
		height: 70px;
	}

	.comparison-model > span {
		font-size: 7px;
	}

	.comparison-model strong {
		font-size: 19px;
	}

	.comparison-row {
		grid-template-columns: .9fr 85px 1.1fr;
	}

	.old-value,
	.new-value {
		font-size: 10px;
	}

	.comparison-label {
		font-size: 6px;
		letter-spacing: .08em;
	}
}


/* ===================================================== */
/* SOURCE */
/* ===================================================== */

.source-note {
	padding: 25px 0;
	text-align: center;
}

.source-note p {
	max-width: 900px;
	margin: 0 auto;
	color: var(--muted);
	font-size: 11px;
	line-height: 1.7;
}

.source-note strong {
	color: var(--accent);
}


/* ===================================================== */
/* CTA */
/* ===================================================== */

.cta-section {
	padding: 110px 0;
	background: var(--bg);
}

.cta {
	position: relative;
	overflow: hidden;
	padding: 75px 50px;
	border: 1px solid rgba(68,78,134,.2);
	border-radius: 30px;
	text-align: center;
	background:
		radial-gradient(
			circle at 50% 0%,
			rgba(68,78,134,.1),
			transparent 60%
		),
		#eef0f6;
}

.cta h2 {
	margin: 18px 0 0;
	font-family: 'Syne', sans-serif;
	font-size: clamp(2.5rem, 5vw, 5rem);
	line-height: .95;
	letter-spacing: -.05em;
}

.cta p {
	max-width: 560px;
	margin: 25px auto 0;
	color: #5c6079;
	line-height: 1.7;
	font-size: 14px;
}

.cta-button {
	margin-top: 32px;
	background: var(--accent);
	color: #ffffff;
}

.cta-button:hover {
	transform: translateY(-3px);
	box-shadow: 0 18px 45px rgba(68,78,134,.25);
}


/* ===================================================== */
/* WHATSAPP */
/* ===================================================== */

.floating-whatsapp {
	position: fixed;
	right: 24px;
	bottom: calc(24px + env(safe-area-inset-bottom));
	z-index: 999;
	width: 58px;
	height: 58px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	background: #25d366;
	color: white;
	text-decoration: none;
	box-shadow: 0 12px 35px rgba(37,211,102,.25);
	animation: whatsappPulse 2.5s infinite;
}

@keyframes whatsappPulse {

	0% {
		box-shadow:
			0 0 0 0 rgba(37,211,102,.45);
	}

	70% {
		box-shadow:
			0 0 0 13px rgba(37,211,102,0);
	}

	100% {
		box-shadow:
			0 0 0 0 rgba(37,211,102,0);
	}

}


/* ===================================================== */
/* ANIMACIONES */
/* ===================================================== */

.hero-in {
	opacity: 0;
	transform: translateY(24px);
	animation:
		heroIn .8s cubic-bezier(.16,1,.3,1)
		forwards;
}

.hero-in-1 {
	animation-delay: .1s;
}

@keyframes heroIn {

	to {
		opacity: 1;
		transform: translateY(0);
	}

}


