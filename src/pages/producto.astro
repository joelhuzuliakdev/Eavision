<script is:inline>
	// Navbar: fondo más opaco al hacer scroll
	window.addEventListener('scroll', () => {
		const nav = document.getElementById('navbar');
		if (nav) nav.style.background = window.scrollY > 50 ? 'rgba(255,255,255,0.97)' : 'rgba(255,255,255,0.88)';
	});

	// Hamburger / menú mobile
	let menuOpen = false;

	document.getElementById('hamburger')?.addEventListener('click', () => {
		menuOpen = !menuOpen;
		const menu = document.getElementById('mobileMenu');
		if (menu) {
			menu.style.display = menuOpen ? 'flex' : 'none';
		}
	});

	function closeMobileMenu() {
		menuOpen = false;
		const menu = document.getElementById('mobileMenu');
		if (menu) menu.style.display = 'none';
	}
	window.closeMobileMenu = closeMobileMenu;

	const gallery = document.getElementById('gallery');
	const prevButton = document.getElementById('gallery-prev');
	const nextButton = document.getElementById('gallery-next');

	let galleryPosition = 0;

	function getGalleryStep() {

		if (!gallery) return 0;

		const card = gallery.querySelector('.gallery-card');

		if (!card) return 0;

		const gap = 16;

		return card.getBoundingClientRect().width + gap;
	}


	function updateGallery() {

		if (!gallery) return;

		const cards =
			gallery.querySelectorAll('.gallery-card');

		if (!cards.length) return;

		const step = getGalleryStep();

		const visible =
    window.innerWidth <= 640
        ? 1
        : window.innerWidth <= 1024
            ? 2
            : 3;

		const maxPosition =
			Math.max(0, cards.length - visible);

		galleryPosition =
			Math.max(
				0,
				Math.min(
					galleryPosition,
					maxPosition
				)
			);

		gallery.style.transform =
			`translateX(-${galleryPosition * step}px)`;
	}


	nextButton?.addEventListener(
		'click',
		() => {

			galleryPosition++;

			updateGallery();

		}
	);


	prevButton?.addEventListener(
		'click',
		() => {

			galleryPosition--;

			updateGallery();

		}
	);


	window.addEventListener(
		'resize',
		updateGallery
	);


	/* ===================================================== */
	/* SWIPE MOBILE */
	/* ===================================================== */

	let touchStartX = 0;
	let touchEndX = 0;

	gallery?.addEventListener(
		'touchstart',
		(event) => {

			touchStartX =
				event.changedTouches[0].screenX;

		},
		{ passive: true }
	);


	gallery?.addEventListener(
		'touchend',
		(event) => {

			touchEndX =
				event.changedTouches[0].screenX;

			const distance =
				touchStartX - touchEndX;

			if (Math.abs(distance) < 40) return;

			if (distance > 0) {

				galleryPosition++;

			} else {

				galleryPosition--;

			}

			updateGallery();

		},
		{ passive: true }
	);


	updateGallery();


	/* ===================================================== */
	/* LAZY VIDEO */
	/* No se descarga el .mp4 hasta que la sección está a 200px */
	/* de entrar en el viewport. Evita cargar varios MB de video */
	/* si el usuario nunca llega a esa sección. */
	/* ===================================================== */

	const lazyVideo = document.getElementById('operacion-video');

	if (lazyVideo && 'IntersectionObserver' in window) {

		const videoObserver = new IntersectionObserver(
			(entries) => {

				entries.forEach((entry) => {

					if (entry.isIntersecting) {

						const source = lazyVideo.querySelector('source[data-src]');

						if (source) {
							source.src = source.dataset.src;
							lazyVideo.load();
							lazyVideo.play().catch(() => {
								// Autoplay bloqueado (ej. ahorro de datos): el poster queda visible.
							});
						}

						videoObserver.unobserve(lazyVideo);
					}

				});

			},
			{ rootMargin: '200px' }
		);

		videoObserver.observe(lazyVideo);

	} else if (lazyVideo) {

		// Fallback para navegadores sin IntersectionObserver
		const source = lazyVideo.querySelector('source[data-src]');
		if (source) {
			source.src = source.dataset.src;
			lazyVideo.load();
		}

	}

	/* ===================================================== */
	/* TABS DE ESPECIFICACIONES TÉCNICAS */
	/* ===================================================== */

	const technicalTabButtons = document.querySelectorAll('.technical-tabs span');
	const technicalPanels = document.querySelectorAll('.technical-panel');

	technicalTabButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const targetIndex = button.getAttribute('data-tab-index');

			technicalTabButtons.forEach((btn) => btn.classList.remove('active'));
			button.classList.add('active');

			technicalPanels.forEach((panel) => {
				panel.style.display =
					panel.getAttribute('data-tab-panel') === targetIndex ? '' : 'none';
			});
		});
	});
</script>