---
import Layout from '../layouts/Layout.astro';

const title = 'EAV-J150 | Drone Agrícola de Alta Capacidad | EaVision';

const description =
	'EAV-J150: drone agrícola de 70L y 80kg de esparcido sólido, caudal de 40 L/min y rendimiento de 25-40 ha/h. Generador, dispersor de sólidos, antena RTK y mapeo. Distribuido por Terrallink en Santa Cruz, Bolivia.';

const canonicalURL = 'https://www.eavision.com/eav-j150'; // ← reemplazar por la URL real de la página

const ogImage = 'https://www.eavision.com/droneVolandoSoja.webp'; // ← reemplazar por la URL absoluta real

const whatsapp =
	'https://wa.me/5493510000000?text=Hola!%20Me%20interesa%20el%20EAV-J150.%20Quisiera%20recibir%20m%C3%A1s%20informaci%C3%B3n.';

const galleryItems = [
	{
		number: '01',
		title: 'Carga Ultra-Rápida',
		description:
			'Sistema de baterías de última generación con carga completa en solo 9 minutos, para maximizar el tiempo en el aire y minimizar el tiempo en tierra. Con rotación de tres baterías, permite una operación en campo prácticamente continua.',
		image: '/eavJ150//eavBateria.webp',
	},
	{
		number: '02',
		title: 'Boquillas Mejoradas para Rendimiento Superior',
		description:
			'Tecnología de boquillas avanzadas con cuatro tamaños de gota ajustables en un solo vuelo, desde gotas gruesas que reducen la deriva hasta gotas ultra-finas que penetran el dosel. Mantiene un alto flujo de hasta 40 L/min.',
		image: '/eavJ150//eavBoquillas.webp',
	},
	{
		number: '03',
		title: 'Sistema Laser Compound-Eye: Detección Esférica 360°',
		description:
			'Sistema de fusión de sensores con LiDAR frontal Scope128, radar giratorio superior 360° y radar trasero. Detecta obstáculos desde 1 cm, incluyendo ramas, tensores, postes y cables, de día o de noche, ajustando la ruta para evitarlos.',
		image: '/eavJ150//eavSistemaLaser.webp',
	},
	{
		number: '04',
		title: 'Esparcidor de Sólidos de Alto Rendimiento',
		description:
			'Tolva de 100 L con capacidad de hasta 80 kg, diseñada para transportar dos bolsas de fertilizante en un solo vuelo. Compatible con materiales húmedos o secos como fertilizantes, pesticidas, cal y semillas, con distribución uniforme de 4 a 8 metros y sistema anti-obstrucción.',
		image: '/eavJ150//eavEsparcidor.webp',
	},
	{
		number: '05',
		title: 'Levantamiento de Carga: Rápido, Alto y Estable',
		description:
			'Sistema optimizado para transportar hasta 75 kg, con ascenso estable, navegación automática entre puntos de despegue y descarga y evasión de obstáculos 360°. Alcanza hasta 100 m de altura y mejora la eficiencia operativa en un 25%.',
		image: '/eavJ150//eavTransporte.webp',
	},
];

const navigationFeatures = [
	{
		number: '1',
		title: 'Detección 360° de alta precisión',
		description:
			'LiDAR frontal Scope128 + radar giratorio superior 360° + radar trasero.',
	},
	{
		number: '2',
		title: 'Seguimiento de terreno',
		description:
			'Lectura del terreno para mantener una operación estable.',
	},
	{
		number: '3',
		title: 'Navegación y mapeo',
		description:
			'Integración de navegación precisa y herramientas de mapeo.',
	},
	{
		number: '4',
		title: 'Operación nocturna y seguridad',
		description:
			'Sistemas de detección preparados para operación continua.',
	},
];

const technicalSpecs = [
	['Capacidad Tanque', '70 L nominal (73 L máx)'],
	['Flujo Máximo', '40 L/min (±5%)'],
	['Boquillas', '2 o 4 · EAV-CCMS60'],
	['Tamaño de Gota', '10–500 μm'],
	['Ancho Pulverización', '4–15 m'],
	['Depósito Sólido', '80 kg'],
	['Carga Rápida', '9 min (30–95%)'],
	['Protección', 'IPX6K / IP67'],
	['Rendimiento', '25–40 ha/h'],
];

// JSON-LD: datos estructurados de producto para resultados enriquecidos en Google
const productJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: 'EAV-J150',
	description: description,
	image: ogImage,
	brand: {
		'@type': 'Brand',
		name: 'EaVision',
	},
	category: 'Drone agrícola',
	additionalProperty: [
		{ '@type': 'PropertyValue', name: 'Capacidad Tanque', value: '70 L' },
		{ '@type': 'PropertyValue', name: 'Depósito Sólido', value: '80 kg' },
		{ '@type': 'PropertyValue', name: 'Flujo Máximo', value: '40 L/min' },
		{ '@type': 'PropertyValue', name: 'Rendimiento', value: '25-40 ha/h' },
	],
};
---

<Layout title={title} description={description}>

	<!-- ===================================================== -->
	<!-- SEO -->
	<!-- ===================================================== -->

	<link rel="canonical" href={canonicalURL} />

	<!-- Open Graph -->
	<meta property="og:type" content="product" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:locale" content="es_AR" />
	<meta property="og:site_name" content="EaVision" />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />

	<!-- Datos estructurados (JSON-LD) -->
	<script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />

	<!-- ===================================================== -->
	<!-- FUENTE -->
	<!-- ===================================================== -->

	<link
		rel="preconnect"
		href="https://fonts.googleapis.com"
	/>

	<link
		rel="preconnect"
		href="https://fonts.gstatic.com"
		crossorigin="anonymous"
	/>

	<link
		href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap"
		rel="stylesheet"
	/>

	<link
		rel="stylesheet"
		href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
		referrerpolicy="no-referrer"
	/>

	<!-- Precarga la imagen del hero: es el LCP de la página -->
	<link
		rel="preload"
		as="image"
		href="/droneVolandoSoja.webp"
		fetchpriority="high"
	/>

	<!-- ===================================================== -->
	<!-- NAVBAR -->
	<!-- ===================================================== -->

	<nav
		id="navbar"
		class="fixed inset-x-0 top-0 z-50 border-b border-[rgba(68,78,134,0.15)] bg-[rgba(255,255,255,0.88)] backdrop-blur-xl transition-all duration-300"
		aria-label="Navegación principal"
	>
		<div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">

			<!-- Logo -->
			<a
				href="/"
				aria-label="EA Vision - Inicio"
				class="flex items-center"
			>
				<img
					src="/logos/logoEavisionAzul.webp"
					alt="EA Vision"
					class="h-12 sm:h-14 lg:h-16 w-auto transition-transform duration-300 hover:scale-105"
					loading="eager"
					decoding="async"
				/>
			</a>

			<!-- Desktop -->
			<ul class="hidden md:flex items-center gap-7 lg:gap-10">
            <li>
					<a href="/" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Inicio
					</a>
				</li>
				<li>
					<a href="/#ventas" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Equipos
					</a>
				</li>
				<li>
					<a href="/#servicios" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Servicios
					</a>
				</li>
				<li>
					<a href="/#nosotros" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Nosotros
					</a>
				</li>

				<li>
					<a
						href={whatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-xl bg-[#444e86] px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#5b67a8]"
					>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.173.199-.272.347-.47.347-.198 0-.52-.075-.892-.223-.371-.149-1.046-.385-1.99-1.23-.736-.655-1.232-1.463-1.38-1.711-.149-.248-.016-.382.112-.51.114-.114.248-.297.372-.446.124-.149.165-.248.248-.421.083-.174.041-.322-.021-.446-.062-.124-.57-1.37-.78-1.876-.205-.492-.414-.425-.57-.433-.148-.007-.322-.009-.495-.009-.173 0-.454.065-.692.322-.238.256-.908.887-.908 2.164 0 1.277.929 2.504 1.058 2.677.128.173 1.827 2.791 4.426 3.912.619.267 1.101.426 1.477.545.621.198 1.185.17 1.632.103.498-.074 1.531-.626 1.747-1.23.215-.603.215-1.12.149-1.23-.062-.108-.235-.173-.495-.297zM12.05 21.65h-.004a9.7 9.7 0 0 1-4.93-1.347l-.354-.21-3.66.96.977-3.565-.23-.366a9.72 9.72 0 0 1-1.49-5.18c.002-5.37 4.373-9.738 9.744-9.738 2.603 0 5.047 1.015 6.883 2.852a9.69 9.69 0 0 1 2.85 6.895c-.002 5.37-4.373 9.738-9.786 9.738zm8.288-18.026A11.69 11.69 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.893c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.605-8.277z"/>
						</svg>
						WhatsApp
					</a>
				</li>
			</ul>

			<!-- Botón hamburguesa -->
			<button
				id="hamburger"
				class="flex h-10 w-10 items-center justify-center rounded-lg border border-[rgba(68,78,134,0.2)] md:hidden"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobileMenu"
			>
				<div class="flex flex-col gap-1.5">
					<span class="h-[2px] w-6 rounded-full bg-[#14152a]"></span>
					<span class="h-[2px] w-6 rounded-full bg-[#14152a]"></span>
					<span class="h-[2px] w-6 rounded-full bg-[#14152a]"></span>
				</div>
			</button>

		</div>
	</nav>

	<!-- MOBILE NAV MENU -->
	<div id="mobileMenu" class="hidden fixed top-[70px] left-0 right-0 z-[99] bg-white border-b border-[rgba(68,78,134,0.15)] px-6 py-8 flex-col gap-6">
		<a href="/#ventas"
		class="text-[#5c6079] no-underline text-base font-medium hover:text-[#444e86] transition-colors"
		onclick="closeMobileMenu()">
			Equipos
		</a>
		<a href="/#servicios" class="text-[#5c6079] no-underline text-base font-medium hover:text-[#444e86] transition-colors" onclick="closeMobileMenu()">Servicios</a>
		<a href="/#nosotros" class="text-[#5c6079] no-underline text-base font-medium hover:text-[#444e86] transition-colors" onclick="closeMobileMenu()">Nosotros</a>
		<a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-[#444e86] text-white px-5 py-3 rounded-md font-semibold text-sm text-center no-underline" onclick="closeMobileMenu()">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.173.199-.272.347-.47.347-.198 0-.52-.075-.892-.223-.371-.149-1.046-.385-1.99-1.23-.736-.655-1.232-1.463-1.38-1.711-.149-.248-.016-.382.112-.51.114-.114.248-.297.372-.446.124-.149.165-.248.248-.421.083-.174.041-.322-.021-.446-.062-.124-.57-1.37-.78-1.876-.205-.492-.414-.425-.57-.433-.148-.007-.322-.009-.495-.009-.173 0-.454.065-.692.322-.238.256-.908.887-.908 2.164 0 1.277.929 2.504 1.058 2.677.128.173 1.827 2.791 4.426 3.912.619.267 1.101.426 1.477.545.621.198 1.185.17 1.632.103.498-.074 1.531-.626 1.747-1.23.215-.603.215-1.12.149-1.23-.062-.108-.235-.173-.495-.297zM12.05 21.65h-.004a9.7 9.7 0 0 1-4.93-1.347l-.354-.21-3.66.96.977-3.565-.23-.366a9.72 9.72 0 0 1-1.49-5.18c.002-5.37 4.373-9.738 9.744-9.738 2.603 0 5.047 1.015 6.883 2.852a9.69 9.69 0 0 1 2.85 6.895c-.002 5.37-4.373 9.738-9.786 9.738zm8.288-18.026A11.69 11.69 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.893c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.605-8.277z"/>
			</svg>
			Cotizar
		</a>
	</div>


	<!-- ===================================================== -->
	<!-- CONTENIDO -->
	<!-- ===================================================== -->

	<main class="product-page pt-[72px]">


		<!-- ================================================= -->
		<!-- HERO -->
		<!-- ================================================= -->

		<section class="hero-section">

			<div class="hero-container">

				<div class="hero-image-wrap">

					<!--
						Imagen del hero = LCP (Largest Contentful Paint) de la página.
						fetchpriority="high" + loading="eager" para que cargue primero.
						NUNCA poner loading="lazy" acá.
					-->
					<img
						src="/droneVolandoSoja.webp"
						alt="Drone agrícola EaVision EAV-J150 pulverizando un cultivo de soja"
						fetchpriority="high"
						loading="eager"
						decoding="async"
					/>

					<div class="hero-overlay"></div>

					<div class="hero-grid"></div>


					<div class="hero-content">

						<div class="hero-status hero-in">
							<span></span>
							DISPONIBLE
						</div>

						<h1 class="hero-title hero-in">
							EAV-J150
						</h1>

						<p class="hero-subtitle hero-in">
							Drone agrícola de alta capacidad
							<br class="hidden-mobile" />
							en kit profesional.
						</p>

						<p class="hero-description hero-in">
							Generador de primera línea, dispersor de sólidos,
							antena RTK y herramienta de mapeo.
						</p>

						<div class="hero-actions hero-in">

							<a
								href={whatsapp}
								target="_blank"
								rel="noopener noreferrer"
								class="primary-button"
							>
								Pedir cotización
								<span>↗</span>
							</a>

							<a
								href="#especificaciones"
								class="secondary-button"
							>
								Ver especificaciones
							</a>

						</div>

					</div>


					<!-- MÉTRICAS -->

					<div class="hero-metrics">

						<div>
							<strong>70</strong>
							<span>L</span>
							<small>Depósito líquido</small>
						</div>

						<div>
							<strong>80</strong>
							<span>kg</span>
							<small>Esparcidor sólido</small>
						</div>

						<div>
							<strong>40</strong>
							<span>L/min</span>
							<small>Flujo máximo</small>
						</div>

						<div>
							<strong>9</strong>
							<span>min</span>
							<small>Carga rápida</small>
						</div>

					</div>

				</div>

			</div>

		</section>


		<!-- ================================================= -->
		<!-- INTRO -->
		<!-- ================================================= -->

		<section class="intro-section">

			<div class="content-width">

				<div class="section-number">
					01 — EAV-J150
				</div>

				<div class="intro-grid">

					<div>

						<h2>
							Tecnología para trabajar
							<span>más hectáreas.</span>
						</h2>

					</div>

					<div class="intro-copy">

						<p>
							El <strong>EAVISION J150</strong> es un dron
							de pulverización de 70 litros de tanque y
							80 kilos de esparcido sólido, con caudal de
							40 L/min y un rendimiento de 25 a 40
							hectáreas por hora.
						</p>

						<p>
							Integra LiDAR frontal Scope128 y detección
							esférica de obstáculos desde 1 cm; las
							baterías cargan del 30% al 95% en 9 minutos.
						</p>

						<p>
							Terrallink lo distribuye en Santa Cruz,
							Bolivia.
						</p>

					</div>

				</div>

			</div>

		</section>


		<!-- ================================================= -->
		<!-- GALERÍA -->
		<!-- ================================================= -->

		<section class="gallery-section">

			<div class="content-width">

				<div class="section-heading-row">

					<div>

						<div class="eyebrow">
							02 — GALERÍA
						</div>

						<h2>
							Conocé el <span>EAV-J150</span>
						</h2>

						<p>
							Una mirada al equipo y a las distintas
							aplicaciones de la tecnología EaVision.
						</p>

					</div>

					<div class="gallery-controls">

						<button
							type="button"
							id="gallery-prev"
							aria-label="Imagen anterior"
						>
							←
						</button>

						<button
							type="button"
							id="gallery-next"
							aria-label="Imagen siguiente"
						>
							→
						</button>

					</div>

				</div>


				<div class="gallery-wrapper">

					<div
						id="gallery"
						class="gallery-track"
					>

						{
							galleryItems.map((item, index) => (

								<article class="gallery-card">

									<div class="gallery-card-top">

										<span>
											{item.number}
										</span>

										<div class="gallery-line"></div>

										<strong>
											{item.title}
										</strong>

									</div>


									<div class="gallery-media">

										{
											item.image ? (

												<img
													src={item.image}
													alt={`EAV-J150: ${item.title}`}
													loading="lazy"
													decoding="async"
													fetchpriority={index < 2 ? 'low' : undefined}
												/>

											) : (

												<div class="media-placeholder">
													<div class="placeholder-icon">+</div>
													<div>
														<span>IMAGEN</span>
														<strong>PRÓXIMAMENTE</strong>
													</div>
												</div>

											)
										}

									</div>

									<div class="gallery-card-body">
										<p>{item.description}</p>
									</div>

								</article>

							))
						}

					</div>

				</div>

			</div>

		</section>


		<!-- ================================================= -->
		<!-- VIDEO -->
		<!-- ================================================= -->

		<section class="video-section">

			<div class="content-width">

				<div class="video-header">

					<div>

						<div class="eyebrow">
							03 — EN ACCIÓN
						</div>

						<h2>
							El EAV-J150
							<span>en operación.</span>
						</h2>

					</div>

					<p>
						Mirá al EAV-J150 en pleno vuelo de
						pulverización sobre un cultivo real.
					</p>

				</div>


				<div class="video-container">

					<!--
						VIDEO LAZY: no se descarga el .mp4 hasta que la sección
						está por entrar en pantalla (ver script "lazy-video" al final).
						data-src en vez de src evita la descarga inmediata.
					-->
					<video
						class="video-player"
						id="operacion-video"
						loop
						muted
						playsinline
						preload="none"
						poster="/droneVolandoSoja.webp"
						aria-label="Video del EAV-J150 en operación de pulverización"
					>
						<source data-src="/videos/dronOperacion.mp4" type="video/mp4" />
						Tu navegador no soporta el elemento de video.
					</video>

				</div>

			</div>

		</section>


		<!-- ================================================= -->
		<!-- KIT -->
		<!-- ================================================= -->

		<section class="kit-section">

			<div class="content-width">

				<div class="section-heading-centered">

					<div class="eyebrow">
						04 — KIT COMPLETO
					</div>

					<h2>
						Todo lo que necesitás
						<span>para operar desde el día 1.</span>
					</h2>

				</div>


				<div class="kit-grid">

					<div class="kit-card">

						<div class="kit-number">
							01
						</div>

						<div class="kit-image-placeholder">
							<img
								src="/eavKit/bateria3.webp"
								alt="Batería del kit EAV-J150"
								loading="lazy"
								decoding="async"
							/>
						</div>

						<h3>
							Batería × 3
						</h3>

						<p>
							45.000 mAh · carga en 9 min
						</p>

					</div>


					<div class="kit-card">

						<div class="kit-number">
							02
						</div>

						<div class="kit-image-placeholder">
							<img
								src="/eavKit/cargadorDual.webp"
								alt="Cargador dual del kit EAV-J150"
								loading="lazy"
								decoding="async"
							/>
						</div>

						<h3>
							Cargador Dual
						</h3>

						<p>
							13.000 W · doble puerto
						</p>

					</div>


					<div class="kit-card">

						<div class="kit-number">
							03
						</div>

						<div class="kit-image-placeholder">
							<img
								src="/eavKit/controlRc60.webp"
								alt="Control RC60 del kit EAV-J150"
								loading="lazy"
