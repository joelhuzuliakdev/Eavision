/* ===================================================== */
/* GENERAL */
/* ===================================================== */

.content-width {
	width: min(1200px, calc(100% - 48px));
	margin: 0 auto;
}

.eyebrow {
	font-size: 10px;
	letter-spacing: .28em;
	text-transform: uppercase;
	color: var(--accent);
	font-weight: 600;
}

.section-number {
	color: #5c6079;
	font-size: 10px;
	letter-spacing: .25em;
	text-transform: uppercase;
	margin-bottom: 55px;
}


/* ===================================================== */
/* HERO */
/* ===================================================== */

.hero-section {
	padding: 24px 24px 80px;
	background: var(--bg);
}

.hero-container {
	max-width: 1400px;
	margin: auto;
}

.hero-image-wrap {
	position: relative;
	min-height: 720px;
	overflow: hidden;
	border-radius: 32px;
	border: 1px solid var(--line);
	background: #0d0e1e;
	box-shadow: 0 35px 100px rgba(23, 26, 60, 0.25);
}

.hero-image-wrap > img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.hero-overlay {
	position: absolute;
	inset: 0;
	background:
		linear-gradient(
			90deg,
			rgba(13,14,30,.92) 0%,
			rgba(13,14,30,.63) 42%,
			rgba(13,14,30,.12) 100%
		),
		linear-gradient(
			0deg,
			rgba(13,14,30,.82) 0%,
			transparent 55%
		);
}

.hero-grid {
	position: absolute;
	inset: 0;
	opacity: .18;
	background-image:
		linear-gradient(rgba(158,169,225,.15) 1px, transparent 1px),
		linear-gradient(90deg, rgba(158,169,225,.15) 1px, transparent 1px);
	background-size: 80px 80px;
	mask-image: linear-gradient(to right, black, transparent 75%);
}

.hero-content {
	position: absolute;
	left: 8%;
	top: 42%;
	transform: translateY(-50%);
	width: min(620px, 82%);
	max-width: 620px;
	z-index: 2;
}

.hero-status {
	display: inline-flex;
	align-items: center;
	gap: 9px;
	margin-top: 24px;
	padding: 8px 13px;
	border-radius: 999px;
	border: 1px solid rgba(158,169,225,.22);
	background: rgba(158,169,225,.08);
	color: #c7cdec;
	font-size: 10px;
	letter-spacing: .15em;
	font-weight: 700;
}

.hero-status span {
	width: 7px;
	height: 7px;
	border-radius: 50%;
	background: #8f9be0;
	box-shadow: 0 0 14px rgba(143,155,224,.7);
}

.hero-title {
	margin: 18px 0 0;
	font-size: clamp(4rem, 7vw, 7rem);
	line-height: .9;
	letter-spacing: -.055em;
	color: white;
	font-weight: 800;
}

.hero-subtitle {
	margin: 28px 0 0;
	font-size: clamp(1.5rem, 3vw, 2.8rem);
	line-height: 1.12;
	color: #eef0f9;
	font-weight: 600;
}

.hero-description {
	max-width: 580px;
	margin-top: 20px;
	color: #b5bbe0;
	line-height: 1.7;
	font-size: 15px;
}

.hero-actions {
	display: flex;
	gap: 12px;
	margin-top: 34px;
}

.primary-button,
.secondary-button,
.cta-button {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 10px;
	padding: 14px 22px;
	border-radius: 999px;
	text-decoration: none;
	font-size: 13px;
	font-weight: 700;
	transition: all .3s ease;
}

.primary-button {
	background: var(--accent);
	color: #ffffff;
}

.primary-button:hover {
	transform: translateY(-3px);
	box-shadow: 0 15px 35px rgba(68,78,134,.3);
}

.secondary-button {
	color: white;
	border: 1px solid rgba(255,255,255,.2);
	background: rgba(255,255,255,.05);
	backdrop-filter: blur(10px);
}

.secondary-button:hover {
	border-color: rgba(158,169,225,.5);
	background: rgba(158,169,225,.08);
}

.hero-metrics {
	position: absolute;
	z-index: 3;
	left: 8%;
	bottom: 42px;
	display: flex;
	gap: 0;
}

.hero-metrics > div {
	min-width: 135px;
	padding: 0 25px;
	border-left: 1px solid rgba(255,255,255,.18);
}

.hero-metrics > div:first-child {
	padding-left: 0;
	border-left: 0;
}

.hero-metrics strong {
	font-family: 'Syne', sans-serif;
	font-size: 30px;
	color: white;
}

.hero-metrics span {
	color: #9ea9e5;
	font-size: 12px;
	margin-left: 4px;
}

.hero-metrics small {
	display: block;
	margin-top: 4px;
	color: #9aa0c4;
	font-size: 9px;
	text-transform: uppercase;
	letter-spacing: .12em;
}


/* ===================================================== */
/* INTRO */
/* ===================================================== */

.intro-section {
	padding: 120px 0;
	background: var(--bg);
}

.intro-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 100px;
}

.intro-grid h2 {
	margin: 0;
	font-size: clamp(2.7rem, 5vw, 5.5rem);
	line-height: .96;
	letter-spacing: -.05em;
}

.intro-grid h2 span,
.spec-heading h2 span,
.center-heading h2 span,
.cta h2 span {
	display: block;
	color: #444e86;
}

.intro-copy {
	padding-top: 5px;
}

.intro-copy p {
	margin: 0 0 22px;
	color: #5c6079;
	font-size: 16px;
	line-height: 1.85;
}

.intro-copy strong {
	color: #14152a;
}


/* ===================================================== */
/* GALERÍA */
/* ===================================================== */

.gallery-section {
	padding: 120px 0;
	background: #eef0f6;
}

.section-heading-row {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 40px;
	margin-bottom: 50px;
}

.section-heading-row h2,
.video-header h2 {
	margin: 15px 0 0;
	font-size: clamp(2.5rem, 5vw, 5rem);
	line-height: .95;
	letter-spacing: -.05em;
}

.section-heading-row h2 span,
.video-header h2 span {
	color: #444e86;
}

.section-heading-row p {
	max-width: 450px;
	margin: 20px 0 0;
	color: #5c6079;
	line-height: 1.7;
}

.gallery-controls {
	display: flex;
	gap: 8px;
}

.gallery-controls button {
	width: 50px;
	height: 50px;
	border: 1px solid var(--line);
	border-radius: 50%;
	background: transparent;
	color: #14152a;
	font-size: 19px;
	cursor: pointer;
	transition: all .25s ease;
}

.gallery-controls button:hover {
	background: var(--accent);
	border-color: var(--accent);
	color: #ffffff;
}

.gallery-wrapper {
	overflow: hidden;
}

.gallery-track {
	display: flex;
	gap: 16px;
	transition: transform .55s cubic-bezier(.16,1,.3,1);
}

.gallery-card {
	flex: 0 0 calc(42% - 8px);
	min-width: 300px;
	border: 1px solid var(--line);
	border-radius: 25px;
	overflow: hidden;
	background: #ffffff;
}

.gallery-card-top {
	display: flex;
	align-items: center;
	gap: 13px;
	height: 58px;
	padding: 0 18px;
	color: #5c6079;
	font-size: 10px;
	letter-spacing: .12em;
	text-transform: uppercase;
}

.gallery-card-top strong {
	color: #14152a;
	font-size: 10px;
	white-space: nowrap;
}

.gallery-line {
	height: 1px;
	flex: 1;
	background: var(--line);
}

.gallery-media {
	height: 430px;
	background:
		radial-gradient(circle at 50% 45%, rgba(68,78,134,.07), transparent 45%),
		#eef0f6;
}

.gallery-media img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.gallery-card-body {
	padding: 20px 18px 24px;
}

.gallery-card-body p {
	margin: 0;
	color: #5c6079;
	font-size: 13px;
	line-height: 1.65;
}

.media-placeholder {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 18px;
	color: #8288a0;
	text-align: center;
}

.placeholder-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 72px;
	height: 72px;
	border-radius: 50%;
	border: 1px solid rgba(68,78,134,.25);
	background: rgba(68,78,134,.04);
	color: var(--accent);
	font-size: 32px;
	font-weight: 300;
}

.media-placeholder span,
.media-placeholder strong {
	display: block;
	font-size: 9px;
	letter-spacing: .2em;
}

.media-placeholder strong {
	margin-top: 6px;
	color: #5c6079;
}


/* ===================================================== */
/* VIDEO */
/* ===================================================== */

.video-section {
	padding: 120px 0;
	background: #f6f7fb;
}

.video-header {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 50px;
	margin-bottom: 45px;
}

.video-header > p {
	max-width: 360px;
	margin: 0;
	color: #5c6079;
	line-height: 1.7;
}

.video-container {
	height: 560px;
	border-radius: 30px;
	border: 1px solid var(--line);
	overflow: hidden;
	background: #eef0f6;
}

.video-player {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	background: #eef0f6;
}


/* ===================================================== */
/* KIT */
/* ===================================================== */

.kit-section {
	padding: 130px 0;
	background: #eef0f6;
}

.section-heading-centered {
	text-align: center;
	max-width: 800px;
	margin: 0 auto 70px;
}

.section-heading-centered h2 {
	margin: 18px 0 0;
	font-size: clamp(2.7rem, 5vw, 5.5rem);
	line-height: .95;
	letter-spacing: -.05em;
}

.section-heading-centered h2 span {
	display: block;
	color: #444e86;
}

.kit-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 16px;
}

.kit-card {
	position: relative;
	padding: 25px;
	border: 1px solid var(--line);
	border-radius: 25px;
	background: #ffffff;
	overflow: hidden;
}

.kit-card.wide {
	grid-column: span 1;
}

.kit-number {
	color: var(--accent);
	font-size: 9px;
	letter-spacing: .18em;
}

.kit-image-placeholder {
	height: 230px;
	margin: 22px 0;
	border-radius: 18px;
	border: 1px dashed rgba(68,78,134,.2);
	background:
		radial-gradient(circle at center, rgba(68,78,134,.07), transparent 50%);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	color: #8288a0;
	overflow: hidden;
}

.kit-image-placeholder img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	border-radius: 18px;
}

.kit-image-placeholder div {
	font-size: 34px;
	font-weight: 200;
	color: var(--accent);
}

.kit-image-placeholder span {
	margin-top: 10px;
	font-size: 8px;
	letter-spacing: .2em;
}

.kit-card h3 {
	margin: 0;
	font-family: 'Syne', sans-serif;
	font-size: 19px;
	color: #14152a;
}

.kit-card p {
	margin: 7px 0 0;
	color: #5c6079;
	font-size: 12px;
	line-height: 1.6;
}


/* ===================================================== */
/* ESPECIFICACIONES */
/* ===================================================== */

.specifications-section {
	padding: 130px 0;
	background: #f6f7fb;
}

.spec-heading {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 80px;
	align-items: end;
	margin-bottom: 65px;
}

.spec-heading h2 {
	margin: 17px 0 0;
	font-size: clamp(3rem, 6vw, 6rem);
	line-height: .87;
	letter-spacing: -.06em;
}

.spec-heading > p {
	color: #5c6079;
	font-size: 14px;
	line-height: 1.8;
	max-width: 480px;
}

.big-spec-grid {
	display: grid;
	grid-template-columns: 2fr 1fr 1fr;
	gap: 8px;
	border: 1px solid var(--line);
	border-radius: 28px;
	overflow: hidden;
	background: rgba(68,78,134,.03);
}

.big-spec {
	min-height: 150px;
	padding: 28px;
	background: #ffffff;
	border: 1px solid rgba(68,78,134,.05);
}

.big-spec.featured {
	grid-column: span 2;
	background:
		radial-gradient(circle at 20% 20%, rgba(68,78,134,.1), transparent 55%),
		#eef0f6;
}

.spec-value {
	font-family: 'Syne', sans-serif;
	font-size: clamp(1.8rem, 4vw, 3.2rem);
	font-weight: 800;
	color: #14152a;
}

.spec-label {
	display: inline-flex;
	margin-top: 16px;
	padding: 6px 9px;
	border-radius: 999px;
	background: rgba(68,78,134,.07);
	color: #5c6079;
	font-size: 8px;
	letter-spacing: .16em;
}


/* ===================================================== */
/* NAVEGACIÓN */
/* ===================================================== */

.navigation-module {
	display: grid;
	grid-template-columns: 1fr 280px;
	margin-top: 80px;
	border: 1px solid var(--line);
	border-radius: 28px;
	overflow: hidden;
	background: #eef0f6;
}

.navigation-main {
	padding: 55px;
}

.navigation-main h3 {
	margin: 18px 0;
	font-family: 'Syne', sans-serif;
	font-size: clamp(2rem, 4vw, 3.5rem);
	line-height: 1;
	letter-spacing: -.04em;
}

.navigation-main > p {
	max-width: 700px;
	color: #5c6079;
	font-size: 14px;
	line-height: 1.8;
}

.navigation-pills {
	display: flex;
	flex-wrap: wrap;
	gap: 12px;
	margin-top: 35px;
	padding-top: 28px;
	border-top: 1px solid var(--line);
}

.navigation-pills > div {
	padding: 15px 18px;
	border: 1px solid var(--line);
	border-radius: 14px;
	background: rgba(255,255,255,.6);
}

.navigation-pills strong,
.navigation-pills span {
	display: block;
}

.navigation-pills strong {
	font-family: 'Syne', sans-serif;
	font-size: 13px;
	color: #14152a;
}

.navigation-pills span {
	margin-top: 5px;
	color: #5c6079;
	font-size: 8px;
	text-transform: uppercase;
	letter-spacing: .08em;
}

.navigation-list {
	border-left: 1px solid var(--line);
}

.navigation-item {
	min-height: 88px;
	padding: 18px;
	display: flex;
	gap: 14px;
	border-bottom: 1px solid var(--line);
	color: #5c6079;
	transition: all .25s ease;
}

.navigation-item:last-child {
	border-bottom: 0;
}

.navigation-item.active {
	background: rgba(68,78,134,.06);
	color: #14152a;
}

.navigation-item > span {
	width: 23px;
	height: 23px;
	border: 1px solid var(--line-strong);
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	font-size: 9px;
}

.navigation-item strong {
	font-size: 11px;
	font-weight: 600;
}

.navigation-item p {
	margin: 5px 0 0;
	font-size: 10px;
	line-height: 1.5;
	color: #5c6079;
}


/* ===================================================== */
/* TABLA */
/* ===================================================== */

.detailed-title {
	margin: 65px 0 20px;
	color: #5c6079;
	font-size: 9px;
	letter-spacing: .25em;
}

.technical-table {
	border: 1px solid var(--line);
	border-radius: 25px;
	overflow: hidden;
	background: #eef0f6;
}

.technical-tabs {
	display: flex;
	gap: 0;
	overflow-x: auto;
	border-bottom: 1px solid var(--line);
}

.technical-tabs span {
	flex: 0 0 auto;
	padding: 18px 20px;
	color: #5c6079;
	font-size: 10px;
	white-space: nowrap;
}

.technical-tabs span.active {
	background: rgba(68,78,134,.07);
	color: var(--accent);
}

.technical-row {
	min-height: 66px;
	padding: 0 25px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 20px;
	border-bottom: 1px solid var(--line);
}

.technical-row:last-child {
	border-bottom: 0;
}

.technical-row span {
	color: #5c6079;
	font-size: 13px;
}

.technical-row strong {
	color: #14152a;
	font-family: monospace;
	font-size: 12px;
}


/* ===================================================== */
/* COMPARACIÓN */
/* ===================================================== */

.comparison-section {
	padding: 130px 0;
	background: #eef0f6;
}

.center-heading {
	text-align: center;
}

.center-heading h2 {
	margin: 18px 0 0;
	font-size: clamp(3rem, 6vw, 6rem);
	line-height: .85;
	letter-spacing: -.06em;
}

.comparison {
	max-width: 900px;
	margin: 60px auto 0;
	border: 1px solid var(--line);
	border-radius: 28px;
	overflow: hidden;
	background: #ffffff;
}

.comparison-header {
	display: grid;
	grid-template-columns: 1fr 1fr;
}

.comparison-model {
	padding: 35px;
	text-align: center;
	border-right: 1px solid var(--line);
}

.comparison-model:last-child {
	border-right: 0;
}

.comparison-model.muted {
	opacity: .42;
}

.comparison-image {
	height: 120px;
	margin-bottom: 20px;
}

.comparison-placeholder {
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	border: 1px dashed rgba(68,78,134,.18);
	border-radius: 18px;
	color: #a2a7c4;
	font-size: 25px;
}

.comparison-model > span {
	display: block;
	color: #5c6079;
	font-size: 9px;
	letter-spacing: .18em;
}

.comparison-model strong {
	display: block;
	margin-top: 8px;
	font-family: 'Syne', sans-serif;
	font-size: 22px;
	color: #14152a;
}

.comparison-row {
	display: grid;
	grid-template-columns: 1fr 140px 1fr;
	align-items: center;
	min-height: 75px;
	border-top: 1px solid var(--line);
}

.old-value,
.new-value {
	padding: 20px;
	font-family: monospace;
	font-size: 15px;
}

.old-value {
	text-align: right;
	color: #9aa0c4;
}

.new-value {
	color: var(--accent);
	font-weight: 700;
}

.comparison-label {
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	border-inline: 1px solid var(--line);
	color: #5c6079;
	font-size: 8px;
	line-height: 1.4;
	text-align: center;
	letter-spacing: .14em;
}


/* ===================================================== */
/* SOURCE */
/* ===================================================== */

.source-note {
	padding: 25px 0;
	background: #5b67a8;
}

.source-note p {
	max-width: 900px;
	margin: 0 auto;
	color: #eaecf6;
	font-size: 11px;
	line-height: 1.7;
}

.source-note strong {
	color: #ffffff;
}


/* ===================================================== */
/* CTA */
/* ===================================================== */

.cta-section {
	padding: 110px 0;
	background: var(--bg);
}

.cta {
	position: relative;
	overflow: hidden;
	padding: 75px 50px;
	border: 1px solid rgba(68,78,134,.2);
	border-radius: 30px;
	text-align: center;
	background:
		radial-gradient(
			circle at 50% 0%,
			rgba(68,78,134,.1),
			transparent 60%
		),
		#eef0f6;
}

.cta h2 {
	margin: 18px 0 0;
	font-family: 'Syne', sans-serif;
	font-size: clamp(2.5rem, 5vw, 5rem);
	line-height: .95;
	letter-spacing: -.05em;
}

.cta p {
	max-width: 560px;
	margin: 25px auto 0;
	color: #5c6079;
	line-height: 1.7;
	font-size: 14px;
}

.cta-button {
	margin-top: 32px;
	background: var(--accent);
	color: #ffffff;
}

.cta-button:hover {
	transform: translateY(-3px);
	box-shadow: 0 18px 45px rgba(68,78,134,.25);
}


/* ===================================================== */
/* WHATSAPP */
/* ===================================================== */

.floating-whatsapp {
	position: fixed;
	right: 24px;
	bottom: 24px;
	z-index: 999;
	width: 58px;
	height: 58px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	background: #25d366;
	color: white;
	text-decoration: none;
	box-shadow: 0 12px 35px rgba(37,211,102,.25);
	animation: whatsappPulse 2.5s infinite;
}

@keyframes whatsappPulse {

	0% {
		box-shadow:
			0 0 0 0 rgba(37,211,102,.45);
	}

	70% {
		box-shadow:
			0 0 0 13px rgba(37,211,102,0);
	}

	100% {
		box-shadow:
			0 0 0 0 rgba(37,211,102,0);
	}

}


/* ===================================================== */
/* ANIMACIONES */
/* ===================================================== */

.hero-in {
	opacity: 0;
	transform: translateY(24px);
	animation:
		heroIn .8s cubic-bezier(.16,1,.3,1)
		forwards;
}

.hero-in-1 {
	animation-delay: .1s;
}

@keyframes heroIn {

	to {
		opacity: 1;
		transform: translateY(0);
	}

}


/* ===================================================== */
/* RESPONSIVE */
/* ===================================================== */

@media (max-width: 900px) {

	.hero-image-wrap {
		min-height: 680px;
	}

	.hero-content {
		left: 6%;
		right: 6%;
	}

	.hero-metrics {
		left: 6%;
		right: 6%;
	}

	.hero-metrics > div {
		min-width: 110px;
		padding: 0 15px;
	}

	.intro-grid,
	.spec-heading {
		grid-template-columns: 1fr;
		gap: 40px;
	}

	.navigation-module {
		grid-template-columns: 1fr;
	}

	.navigation-list {
		border-left: 0;
		border-top: 1px solid var(--line);
	}

	.big-spec-grid {
		grid-template-columns: 1fr 1fr;
	}

	.big-spec.featured {
		grid-column: span 2;
	}

	.kit-grid {
		grid-template-columns: 1fr 1fr;
	}

}


@media (max-width: 640px) {

	.content-width {
		width: min(100% - 30px, 1200px);
	}

	.hero-section {
		padding: 12px 12px 60px;
	}

	.hero-image-wrap {
		min-height: 720px;
		border-radius: 22px;
	}

	.hero-content {
		top: 40%;
		left: 24px;
		right: 24px;
	}

	.hero-title {
		font-size: clamp(3.6rem, 19vw, 6rem);
	}

	.hero-subtitle {
		font-size: 1.45rem;
	}

	.hero-description {
		font-size: 13px;
	}

	.hero-actions {
		flex-direction: column;
		align-items: stretch;
	}

	.hero-metrics {
		left: 24px;
		right: 24px;
		bottom: 25px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px 0;
	}

	.hero-metrics > div {
		min-width: 0;
		padding: 0 10px;
	}

	.hero-metrics > div:nth-child(3) {
		padding-left: 0;
	}

	.hero-metrics strong {
		font-size: 25px;
	}

	.intro-section,
	.gallery-section,
	.video-section,
	.kit-section,
	.specifications-section,
	.comparison-section {
		padding: 80px 0;
	}

	.section-heading-row,
	.video-header {
		flex-direction: column;
		align-items: flex-start;
	}

	.section-heading-row h2,
	.video-header h2 {
		font-size: 2.7rem;
	}

	.gallery-card {
		flex-basis: 82%;
	}

	.gallery-media {
		height: 360px;
	}

	.video-container {
		height: 380px;
		border-radius: 22px;
	}

	.kit-grid {
		grid-template-columns: 1fr;
	}

	.kit-card.wide {
		grid-column: span 1;
	}

	.big-spec-grid {
		grid-template-columns: 1fr;
	}

	.big-spec.featured {
		grid-column: span 1;
	}

	.navigation-main {
		padding: 30px 22px;
	}

	.navigation-pills {
		flex-direction: column;
	}

	.technical-tabs span {
		padding: 15px;
	}

	.technical-row {
		padding: 16px;
		align-items: flex-start;
		flex-direction: column;
		gap: 7px;
	}

	.technical-row strong {
		font-size: 11px;
	}

	.comparison {
		border-radius: 20px;
	}

	.comparison-model {
		padding: 18px 10px;
	}

	.comparison-image {
		height: 80px;
	}

	.comparison-row {
		grid-template-columns: 1fr 85px 1fr;
		min-height: 70px;
	}

	.old-value,
	.new-value {
		padding: 12px 8px;
		font-size: 11px;
	}

	.comparison-label {
		font-size: 7px;
	}

	.cta {
		padding: 55px 22px;
	}

	.floating-whatsapp {
		right: 16px;
		bottom: 16px;
		width: 54px;
		height: 54px;
	}

	.hidden-mobile {
		display: none;
	}

}

</style>


<script is:inline>
	// Navbar: fondo más opaco al hacer scroll
	window.addEventListener('scroll', () => {
		const nav = document.getElementById('navbar');
		if (nav) nav.style.background = window.scrollY > 50 ? 'rgba(255,255,255,0.97)' : 'rgba(255,255,255,0.88)';
	});

	// Hamburger / menú mobile
	let menuOpen = false;

	document.getElementById('hamburger')?.addEventListener('click', () => {
		menuOpen = !menuOpen;
		const menu = document.getElementById('mobileMenu');
		if (menu) {
			menu.style.display = menuOpen ? 'flex' : 'none';
		}
	});

	function closeMobileMenu() {
		menuOpen = false;
		const menu = document.getElementById('mobileMenu');
		if (menu) menu.style.display = 'none';
	}
	window.closeMobileMenu = closeMobileMenu;

	const gallery = document.getElementById('gallery');
	const prevButton = document.getElementById('gallery-prev');
	const nextButton = document.getElementById('gallery-next');

	let galleryPosition = 0;

	function getGalleryStep() {

		if (!gallery) return 0;

		const card = gallery.querySelector('.gallery-card');

		if (!card) return 0;

		const gap = 16;

		return card.getBoundingClientRect().width + gap;
	}


	function updateGallery() {

		if (!gallery) return;

		const cards =
			gallery.querySelectorAll('.gallery-card');

		if (!cards.length) return;

		const step = getGalleryStep();

		const visible =
			window.innerWidth <= 640
				? 1
				: window.innerWidth <= 900
					? 2
					: 2;

		const maxPosition =
			Math.max(0, cards.length - visible);

		galleryPosition =
			Math.max(
				0,
				Math.min(
					galleryPosition,
					maxPosition
				)
			);

		gallery.style.transform =
			`translateX(-${galleryPosition * step}px)`;
	}


	nextButton?.addEventListener(
		'click',
		() => {

			galleryPosition++;

			updateGallery();

		}
	);


	prevButton?.addEventListener(
		'click',
		() => {

			galleryPosition--;

			updateGallery();

		}
	);


	window.addEventListener(
		'resize',
		updateGallery
	);


	/* ===================================================== */
	/* SWIPE MOBILE */
	/* ===================================================== */

	let touchStartX = 0;
	let touchEndX = 0;

	gallery?.addEventListener(
		'touchstart',
		(event) => {

			touchStartX =
				event.changedTouches[0].screenX;

		},
		{ passive: true }
	);


	gallery?.addEventListener(
		'touchend',
		(event) => {

			touchEndX =
				event.changedTouches[0].screenX;

			const distance =
				touchStartX - touchEndX;

			if (Math.abs(distance) < 40) return;

			if (distance > 0) {

				galleryPosition++;

			} else {

				galleryPosition--;

			}

			updateGallery();

		},
		{ passive: true }
	);


	updateGallery();


	/* ===================================================== */
	/* LAZY VIDEO */
	/* No se descarga el .mp4 hasta que la sección está a 200px */
	/* de entrar en el viewport. Evita cargar varios MB de video */
	/* si el usuario nunca llega a esa sección. */
	/* ===================================================== */

	const lazyVideo = document.getElementById('operacion-video');

	if (lazyVideo && 'IntersectionObserver' in window) {

		const videoObserver = new IntersectionObserver(
			(entries) => {

				entries.forEach((entry) => {

					if (entry.isIntersecting) {

						const source = lazyVideo.querySelector('source[data-src]');

						if (source) {
							source.src = source.dataset.src;
							lazyVideo.load();
							lazyVideo.play().catch(() => {
								// Autoplay bloqueado (ej. ahorro de datos): el poster queda visible.
							});
						}

						videoObserver.unobserve(lazyVideo);
					}

				});

			},
			{ rootMargin: '200px' }
		);

		videoObserver.observe(lazyVideo);

	} else if (lazyVideo) {

		// Fallback para navegadores sin IntersectionObserver
		const source = lazyVideo.querySelector('source[data-src]');
		if (source) {
			source.src = source.dataset.src;
			lazyVideo.load();
		}

	}
</script>