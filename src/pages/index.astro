---
import Layout from '../layouts/Layout.astro';

const title = 'Eavision | Drones Agrícolas y Tecnología Aérea de Precisión para el Campo';
const description = 'Venta y servicios de drones agrícolas EaVision: pulverización, siembra aérea, fertilización y monitoreo NDVI de cultivos. Reducí costos y aumentá tu rentabilidad. Cotizá sin cargo.';
---

<Layout title={title} description={description}>

	<!-- FONTS: HarmonyOS Sans SC (中文) + HarmonyOS Sans (Latin) -->
	<link rel="stylesheet" href="https://unpkg.com/harmonyos-sans-sc-webfont-splitted@1.1.0/dist/index.css" />

	<!-- Botón flotante de WhatsApp -->
	<a
		href="https://wa.me/5493572548014?text=Hola, quiero solicitar información.,%20quiero%20solicitar%20información."
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Contactar por WhatsApp"
		class="fixed bottom-5 right-5 whatsapp-float z-[999] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-all duration-300 hover:scale-110 hover:shadow-2xl"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 32 32"
			fill="currentColor"
			class="h-7 w-7"
		>
			<path d="M19.11 17.39c-.29-.14-1.71-.84-1.98-.94-.27-.1-.47-.14-.67.14-.2.29-.77.94-.94 1.13-.17.2-.35.22-.64.08-.29-.14-1.23-.45-2.35-1.43-.87-.78-1.46-1.74-1.63-2.03-.17-.29-.02-.45.13-.59.13-.13.29-.35.43-.53.14-.18.19-.31.29-.51.1-.2.05-.37-.02-.51-.08-.14-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.51.08-.78.37-.27.29-1.02 1-.98 2.43.04 1.43 1.02 2.82 1.16 3.02.14.2 2.01 3.07 4.87 4.3.68.29 1.21.46 1.62.59.68.22 1.3.19 1.79.12.55-.08 1.71-.7 1.95-1.37.24-.67.24-1.24.17-1.37-.07-.12-.27-.2-.56-.34z"/>
			<path d="M16.01 3C8.84 3 3 8.84 3 16c0 2.53.73 4.98 2.1 7.1L3.01 29l6.07-2.01A12.9 12.9 0 0 0 16 29c7.17 0 13-5.84 13-13S23.18 3 16.01 3zm0 23.63c-2.09 0-4.13-.56-5.92-1.62l-.42-.25-3.6 1.19 1.18-3.51-.27-.45A10.58 10.58 0 0 1 5.37 16c0-5.86 4.77-10.63 10.63-10.63S26.63 10.14 26.63 16 21.87 26.63 16.01 26.63z"/>
		</svg>
	</a>

	<!-- NAVBAR -->
	<nav
		id="navbar"
		class="fixed inset-x-0 top-0 z-50 border-b border-[rgba(68,78,134,0.15)] bg-[rgba(255,255,255,0.88)] backdrop-blur-xl transition-all duration-300"
		aria-label="Navegación principal"
	>
		<div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">

			<!-- Logo -->
			<a
				href="#"
				aria-label="EA Vision - Inicio"
				class="flex items-center"
			>
				<img
					src="logos/logoEavisionAzul.webp"
					alt="EA Vision"
					class="h-12 sm:h-14 lg:h-16 w-auto transition-transform duration-300 hover:scale-105"
				/>
			</a>

			<!-- Desktop -->
			<ul class="hidden md:flex items-center gap-7 lg:gap-10">
				<li>
					<a href="#nosotros" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Nosotros
					</a>
				</li>

				<li>
					<a href="#ventas" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Equipos
					</a>
				</li>

				<li>
					<a href="#servicios" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Servicios
					</a>
				</li>

				<li>
					<a href="#beneficios" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Beneficios
					</a>
				</li>

				<li>
					<a href="#galeria" class="text-sm text-[#5a5f78] transition-colors hover:text-[#444e86]">
						Galería
					</a>
				</li>

				<li>
					<a
						href="#contacto"
						class="rounded-xl bg-[#444e86] px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#5b67a8]"
					>
						Cotizar
					</a>
				</li>
			</ul>

			<!-- Botón hamburguesa -->
			<button
				id="hamburger"
				class="flex h-10 w-10 items-center justify-center rounded-lg border border-[rgba(68,78,134,0.2)] md:hidden"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobileMenu"
			>
				<div class="flex flex-col gap-1.5">
					<span class="h-[2px] w-6 rounded-full bg-[#14152a]"></span>
					<span class="h-[2px] w-6 rounded-full bg-[#14152a]"></span>
					<span class="h-[2px] w-6 rounded-full bg-[#14152a]"></span>
				</div>
			</button>

		</div>
	</nav>

	<!-- MOBILE NAV MENU -->
	<div id="mobileMenu" class="hidden fixed top-[70px] left-0 right-0 z-[99] bg-white border-b border-[rgba(68,78,134,0.15)] px-6 py-8 flex-col gap-6">
		<a href="#nosotros" class="text-[#5c6079] no-underline text-base font-medium hover:text-[#444e86] transition-colors" onclick="closeMobileMenu()">Nosotros</a>
		<a href="#servicios" class="text-[#5c6079] no-underline text-base font-medium hover:text-[#444e86] transition-colors" onclick="closeMobileMenu()">Servicios</a>
		<a href="#beneficios" class="text-[#5c6079] no-underline text-base font-medium hover:text-[#444e86] transition-colors" onclick="closeMobileMenu()">Beneficios</a>
		<a href="#galeria" class="text-[#5c6079] no-underline text-base font-medium hover:text-[#444e86] transition-colors" onclick="closeMobileMenu()">Galería</a>
		<a href="#contacto" class="bg-[#444e86] text-white px-5 py-3 rounded-md font-semibold text-sm text-center no-underline" onclick="closeMobileMenu()">Cotizar</a>
	</div>

	<!-- HERO -->
	<section class="min-h-screen flex items-center relative px-4 sm:px-8 pt-24 pb-16 overflow-hidden bg-[#0a0a12]" id="hero">
		<!-- VIDEO -->
		<video
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
			poster="/droneVolandoSoja.webp"
			aria-hidden="true"
			will-change: transform;
			class="absolute inset-0 w-full h-full object-cover"
		>
			<source src="/videos/hero.mp4" type="video/mp4" />
			Tu navegador no soporta videos.
		</video>

		<!-- Overlay oscuro -->
		<div class="absolute inset-0 bg-black/70 z-[1]"></div>
		<!-- BG -->
		<div class="absolute inset-0 pointer-events-none"
			style="background: radial-gradient(ellipse 80% 60% at 60% 40%, rgba(68,78,134,0.12) 0%, transparent 70%), radial-gradient(ellipse 40% 40% at 20% 80%, rgba(68,78,134,0.06) 0%, transparent 60%);">
		</div>
		<!-- GRID -->
		<div class="absolute inset-0 pointer-events-none"
			style="background-image: linear-gradient(rgba(68,78,134,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(68,78,134,0.04) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 100%);">
		</div>

		<div class="max-w-[1200px] mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center relative z-10">

			<!-- CONTENT -->
			<div>

				<h1 class="hero-in hero-in-2 font-[Syne] text-[clamp(2.5rem,6vw,4.8rem)] font-extrabold leading-[1.0] mb-6 text-white">
					Tecnología para producir mas
				</h1>

				<p class="hero-in hero-in-3 text-base sm:text-lg text-[#898989] leading-relaxed mb-8 max-w-xl">
					Optimizamos cada hectárea con drones de última generación. Más eficiencia, menos costo, mayor rentabilidad para tu producción agrícola.
				</p>

				<div class="hero-in hero-in-4 flex flex-col sm:flex-row gap-4">
					<a href="#contacto" class="bg-[#444e86] text-white px-7 py-3.5 rounded-lg font-semibold text-base no-underline inline-flex items-center justify-center gap-2 transition-all hover:bg-[#5b67a8] hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(68,78,134,0.3)]">
						Quiero mi drone →
					</a>
					<a href="#servicios" class="hero-in hero-in-5 bg-transparent text-white px-7 py-3.5 rounded-lg font-medium text-base no-underline inline-flex items-center justify-center gap-2 transition-all border border-[rgba(255,255,255,0.15)] hover:border-[rgba(255,255,255,0.35)] hover:bg-[rgba(255,255,255,0.05)]">
						Busco un servicio
					</a>
				</div>

				<!-- STATS -->
				<div class="flex flex-row gap-6 sm:gap-8 mt-10 pt-8 border-t border-[rgba(68,78,134,0.15)]">
					<div>
						<div id="stat-1" class="font-[Syne] text-2xl sm:text-3xl font-extrabold text-white" data-count="85%" data-suffix="%">0%</div>
						<div class="text-xs text-[#898989] mt-1">Menos insumos utilizados</div>
					</div>
					<div>
						<div id="stat-2" class="font-[Syne] text-2xl sm:text-3xl font-extrabold text-white" data-count="35" data-suffix="ha/h">0x</div>
						<div class="text-xs text-[#898989] mt-1">Capacidad de trabajo</div>
					</div>
					<div>
						<div id="stat-3" class="font-[Syne] text-2xl sm:text-3xl font-extrabold text-white" data-count="0" data-suffix="%">0%</div>
						<div class="text-xs text-[#898989] mt-1">Pisoteo de cultivo</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- NOSOTROS -->
	<section class="py-20 sm:py-28 px-4 sm:px-8 bg-[#f6f7fb] relative overflow-hidden" id="nosotros">
		<div class="absolute inset-0 pointer-events-none"
			style="background: radial-gradient(circle at 20% 30%, rgba(68,78,134,0.08), transparent 40%), radial-gradient(circle at 80% 70%, rgba(68,78,134,0.05), transparent 40%);">
		</div>
		<div class="max-w-[1200px] mx-auto relative z-10">
			<div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-20 items-center">

				<!-- Content -->
				<div class="fade-up">
					<div class="inline-block text-[0.97rem] font-medium tracking-[0.12em] uppercase text-[#444e86] mb-4">Nosotros</div>
					<h2 class="font-[Syne] text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.15] text-[#14152a] mb-4">
						Somos Eavision
					</h2>
					<p class="text-base text-[#5c6079] leading-relaxed max-w-[560px]">
						Empresa argentina especializada en tecnología agrícola de precisión y soluciones aéreas para el agro.
					</p>
					<div class="flex flex-col gap-5 mt-8">
						<p class="text-[#5c6079] leading-[1.8] text-[0.97rem]">
							Trabajamos junto a productores, ingenieros agrónomos y contratistas para optimizar cada hectárea mediante drones agrícolas de última generación.
						</p>
						<p class="text-[#5c6079] leading-[1.8] text-[0.97rem]">
							Somos representantes oficiales de <strong class="text-[#14152a]">EaVision</strong>, una de las marcas líderes a nivel mundial en drones inteligentes para pulverización, monitoreo y agricultura de precisión.
						</p>
						<p class="text-[#5c6079] leading-[1.8] text-[0.97rem]">
							Brindamos venta de equipos, capacitación, soporte técnico y servicios profesionales en campo, acompañando a nuestros clientes desde la implementación hasta la operación diaria.
						</p>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-8">
						<div class="flex items-center gap-3 px-4 py-3.5 bg-white border border-[rgba(68,78,134,0.15)] rounded-xl text-sm text-[#14152a] shadow-[0_2px_10px_rgba(23,26,60,0.04)]">
							<span class="text-[#444e86] font-bold">✔</span>
							<span>Representantes oficiales EaVision</span>
						</div>
						<div class="flex items-center gap-3 px-4 py-3.5 bg-white border border-[rgba(68,78,134,0.15)] rounded-xl text-sm text-[#14152a] shadow-[0_2px_10px_rgba(23,26,60,0.04)]">
							<span class="text-[#444e86] font-bold">✔</span>
							<span>Capacitación y soporte técnico</span>
						</div>
						<div class="flex items-center gap-3 px-4 py-3.5 bg-white border border-[rgba(68,78,134,0.15)] rounded-xl text-sm text-[#14152a] shadow-[0_2px_10px_rgba(23,26,60,0.04)]">
							<span class="text-[#444e86] font-bold">✔</span>
							<span>Tecnología agrícola de precisión</span>
						</div>
						<div class="flex items-center gap-3 px-4 py-3.5 bg-white border border-[rgba(68,78,134,0.15)] rounded-xl text-sm text-[#14152a] shadow-[0_2px_10px_rgba(23,26,60,0.04)]">
							<span class="text-[#444e86] font-bold">✔</span>
							<span>Operaciones en todo el país</span>
						</div>
					</div>
				</div>

				<!-- Card -->
				<div class="fade-up [transition-delay:0.2s] relative bg-white border border-[rgba(68,78,134,0.15)] rounded-3xl p-8 sm:p-12 overflow-hidden shadow-[0_20px_60px_rgba(23,26,60,0.08)]">
					<div class="absolute inset-[-20%] pointer-events-none" style="background: radial-gradient(circle, rgba(68,78,134,0.1), transparent 60%); filter: blur(40px);"></div>
					<div class="relative z-10">
						<div class="inline-flex items-center gap-2 bg-[rgba(68,78,134,0.1)] border border-[rgba(68,78,134,0.25)] px-4 py-1.5 rounded-full text-xs text-[#444e86] mb-6">
							Partner Oficial
						</div>
						<h3 class="font-[Syne] text-3xl font-bold text-[#14152a] mb-4 leading-tight">EaVision Argentina</h3>
						<p class="text-[#5c6079] leading-[1.7] mb-8">
							Drones inteligentes diseñados para maximizar rendimiento, reducir costos y transformar la forma de trabajar el campo.
						</p>
						<div class="flex gap-8 pt-6 border-t border-[rgba(68,78,134,0.15)]">
							<div>
								<div class="font-[Syne] text-3xl font-extrabold text-[#3a4384] leading-none">+500</div>
								<div class="text-xs text-[#5c6079] mt-1.5">Hectáreas trabajadas</div>
							</div>
							<div>
								<div class="font-[Syne] text-3xl font-extrabold text-[#3a4384] leading-none">24/7</div>
								<div class="text-xs text-[#5c6079] mt-1.5">Soporte técnico</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- VENTAS -->
	<section class="py-20 sm:py-28 px-4 sm:px-8 bg-white" id="ventas">
		<div class="max-w-[1200px] mx-auto">

			<div class="text-center mb-14 fade-up">
				<div class="inline-block text-[0.97rem] font-medium tracking-[0.12em] uppercase text-[#444e86] mb-4">Equipos en venta</div>
				<h2 class="font-[Syne] text-[clamp(2rem,4vw,3rem)] font-bold text-[#14152a] mb-4">
					Adquirí tu drone agrícola
				</h2>
				<p class="text-[#5c6079] leading-[1.7] max-w-[520px] mx-auto">
					Equipos EaVision disponibles para entrega inmediata. Financiación disponible, capacitación incluida y soporte técnico permanente.
				</p>
			</div>

			<!-- Card del drone -->
			<div class="max-w-3xl mx-auto fade-up">
				<div id="drone-card" class="group relative bg-[#f6f7fb] border border-[rgba(68,78,134,0.2)] rounded-3xl overflow-hidden cursor-pointer transition-all duration-300 hover:border-[rgba(68,78,134,0.45)] hover:shadow-[0_0_60px_rgba(68,78,134,0.1)]"
					onclick="openModal()">

					<div class="grid grid-cols-1 sm:grid-cols-2">

						<!-- Imagen principal -->
						<div class="relative overflow-hidden aspect-square sm:aspect-auto min-h-[280px]">
							<img src="/droneVolandoSoja.webp" alt="Drone agrícola EaVision EA-30 Pro pulverizando un cultivo de soja"
								width="600" height="600" loading="lazy" decoding="async"
								class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
							<div class="absolute inset-0 hidden sm:block"></div>
							<!-- Badge disponible -->
							<div class="absolute top-4 left-4">
								<span class="inline-flex items-center gap-1.5 bg-[rgba(68,78,134,0.15)] border border-[rgba(68,78,134,0.35)] text-[#444e86] text-[0.68rem] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full backdrop-blur-sm">
									<span class="w-1.5 h-1.5 bg-[#444e86] rounded-full animate-pulse"></span>
									Disponible
								</span>
							</div>
						</div>

						<!-- Info -->
						<div class="p-7 sm:p-8 flex flex-col justify-between">
							<div>
								<div class="text-[#444e86] text-xs font-semibold uppercase tracking-widest mb-2">EaVision</div>
								<h3 class="font-[Syne] text-2xl sm:text-3xl font-extrabold text-[#14152a] leading-tight mb-1">EA-30 Pro</h3>
								<p class="text-[#5c6079] text-sm mb-6 leading-relaxed">Drone agrícola de alta capacidad para pulverización, siembra y fertilización de precisión.</p>

								<!-- Specs -->
								<div class="grid grid-cols-2 gap-3 mb-6">
									{[
										{ icon: '💧', label: 'Tanque', val: '30 L' },
										{ icon: '⚡', label: 'Velocidad', val: '8 m/s' },
										{ icon: '🌾', label: 'Cobertura', val: '80-120 ha/día' },
										{ icon: '🎯', label: 'Precisión RTK', val: '±2 cm' },
										{ icon: '🔋', label: 'Autonomía', val: '12 min/carga' },
										{ icon: '⚖️', label: 'Peso', val: '24 kg (lleno)' },
									].map((s) => (
										<div class="flex items-center gap-2.5 bg-white border border-[rgba(68,78,134,0.1)] rounded-xl px-3 py-2.5">
											<span class="text-base" aria-hidden="true">{s.icon}</span>
											<div>
												<div class="text-[0.65rem] text-[#5c6079] leading-none mb-0.5">{s.label}</div>
												<div class="text-xs font-semibold text-[#14152a]">{s.val}</div>
											</div>
										</div>
									))}
								</div>
							</div>

							<!-- Botones -->
							<div class="flex flex-col gap-3" onclick="event.stopPropagation()">
								<a href="https://wa.me/5493510000000?text=Hola!%20Me%20interesa%20el%20drone%20EaVision%20EA-30%20Pro.%20%C2%BFPodr%C3%ADan%20darme%20m%C3%A1s%20informaci%C3%B3n%3F"
									target="_blank" rel="noopener noreferrer"
									class="w-full bg-[#25d366] text-white px-6 py-3.5 rounded-xl font-semibold text-sm text-center no-underline inline-flex items-center justify-center gap-2 transition-all hover:bg-[#20ba5a] hover:-translate-y-0.5">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
									Consultar por WhatsApp
								</a>
								<button onclick="openModal()" class="w-full bg-transparent text-[#14152a] border border-[rgba(68,78,134,0.25)] px-6 py-3 rounded-xl font-medium text-sm inline-flex items-center justify-center gap-2 transition-all hover:border-[rgba(68,78,134,0.35)] hover:bg-[rgba(68,78,134,0.05)] cursor-pointer">
									Ver galería del equipo
								</button>
							</div>
						</div>
					</div>

					<!-- Includes strip -->
					<div class="border-t border-[rgba(68,78,134,0.12)] px-7 sm:px-8 py-4 flex flex-wrap gap-x-6 gap-y-2">
						{['✔ Capacitación incluida', '✔ Garantía 12 meses', '✔ Soporte técnico 24/7', '✔ Envío a todo el país'].map((item) => (
