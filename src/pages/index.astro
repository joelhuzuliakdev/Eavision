<script is:inline>
	(function () {

		const modal = document.getElementById('legalModal');
		const content = document.getElementById('legalModalContent');
		const openButton = document.getElementById('openLegalModal');
		const closeButton = document.getElementById('closeLegalModal');
		const backdrop = document.getElementById('legalModalBackdrop');

		if (!modal || !content || !openButton || !closeButton || !backdrop) {
			return;
		}

		function openLegalModal() {

			modal.classList.remove('hidden');
			modal.classList.add('flex');

			document.body.style.overflow = 'hidden';

			requestAnimationFrame(() => {
				content.classList.remove('opacity-0', 'translate-y-5', 'scale-[0.98]');
				content.classList.add('opacity-100', 'translate-y-0', 'scale-100');
			});

			modal.setAttribute('aria-hidden', 'false');
		}


		function closeLegalModal() {

			content.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
			content.classList.add('opacity-0', 'translate-y-5', 'scale-[0.98]');

			setTimeout(() => {

				modal.classList.remove('flex');
				modal.classList.add('hidden');

				document.body.style.overflow = '';

			}, 300);

			modal.setAttribute('aria-hidden', 'true');
		}


		openButton.addEventListener('click', openLegalModal);

		closeButton.addEventListener('click', closeLegalModal);

		backdrop.addEventListener('click', closeLegalModal);


		document.addEventListener('keydown', (event) => {

			if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
				closeLegalModal();
			}

		});

	})();
</script>

