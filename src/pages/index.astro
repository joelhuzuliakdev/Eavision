<style>
	html {
		scroll-behavior: smooth;
	}
	/* Animaciones que Tailwind no puede generar dinámicamente */
	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-15px); }
	}
	@keyframes radar {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}
	@keyframes progressFill {
		from { width: 0; }
	}

	/* Fade-up animation */
	.fade-up {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}
	.fade-up.visible {
		opacity: 1;
		transform: translateY(0);
	}
	.fade-up.[transition-delay\:0\.1s] { transition-delay: 0.1s; }
	.fade-up.[transition-delay\:0\.2s] { transition-delay: 0.2s; }
	.fade-up.[transition-delay\:0\.3s] { transition-delay: 0.3s; }

	/* Scrollbar */
	::-webkit-scrollbar { width: 4px; }
	::-webkit-scrollbar-track { background: #0a0a12; }
	::-webkit-scrollbar-thumb { background: #444e86; border-radius: 2px; }

	/* Font families: HarmonyOS Sans (texto) / HarmonyOS Sans SC (títulos y CJK) */
	* { font-family: 'HarmonyOS Sans', 'HarmonyOS Sans SC', sans-serif; }
	.font-\[Syne\] { font-family: 'HarmonyOS Sans SC', 'HarmonyOS Sans', sans-serif; }

	/* Select option color fix */
	select option { background: #13141f; color: white; }

	/* Input number arrows remove */
	input[type=number]::-webkit-outer-spin-button,
	input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
	input[type=number] { -moz-appearance: textfield; }

	/* Animate float for drone svg */
	.animate-\[float_4s_ease-in-out_infinite\] { animation: float 4s ease-in-out infinite; }

	/* Animate radar */
	.animate-\[radar_6s_linear_infinite\] { animation: radar 6s linear infinite; }
</style>

<script>
	// Fonts
	if (!document.querySelector('link[href*="fonts.googleapis.com/css2?family=Syne"]')) {
		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = 'https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap';
		document.head.appendChild(link);
	}

	// Modal galería drone
	const modalPhotos = [
		'/droneVolandoSoja.webp',
		'/droneMonitoreo.webp',
		'/droneMapeo.webp',
		'/droneAplicacionFertilizante.webp',
		'/droneSiembraAerea.webp',
	];
	let currentPhoto = 0;

	function openModal() {
		const modal = document.getElementById('drone-modal');
		const inner = document.getElementById('modal-inner');
		modal.classList.remove('opacity-0', 'pointer-events-none');
		inner.classList.remove('translate-y-6');
		document.body.style.overflow = 'hidden';
		selectPhoto(0);
	}

	function closeModal() {
		const modal = document.getElementById('drone-modal');
		const inner = document.getElementById('modal-inner');
		modal.classList.add('opacity-0', 'pointer-events-none');
		inner.classList.add('translate-y-6');
		document.body.style.overflow = '';
	}

	function selectPhoto(index) {
		currentPhoto = index;
		const img = document.getElementById('modal-main-img');
		const counter = document.getElementById('modal-counter');
		if (img) { img.style.opacity = '0'; setTimeout(() => { img.src = modalPhotos[index]; img.style.opacity = '1'; }, 150); }
		if (counter) counter.textContent = `${index + 1} / ${modalPhotos.length}`;
		document.querySelectorAll('.modal-thumb').forEach((t, i) => {
			t.style.borderColor = i === index ? '#444e86' : 'rgba(68,78,134,0.15)';
		});
	}

	function nextPhoto() { selectPhoto((currentPhoto + 1) % modalPhotos.length); }
	function prevPhoto() { selectPhoto((currentPhoto - 1 + modalPhotos.length) % modalPhotos.length); }

	// Cerrar modal con ESC
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

	window.openModal = openModal;
	window.closeModal = closeModal;
	window.selectPhoto = selectPhoto;
	window.nextPhoto = nextPhoto;
	window.prevPhoto = prevPhoto;

	// Navbar scroll
	window.addEventListener('scroll', () => {
		const nav = document.getElementById('navbar');
		if (nav) nav.style.background = window.scrollY > 50 ? 'rgba(10,10,18,0.97)' : 'rgba(10,10,18,0.85)';
	});

	// Hamburger
	let menuOpen = false;
	document.getElementById('hamburger')?.addEventListener('click', () => {
		menuOpen = !menuOpen;
		const menu = document.getElementById('mobileMenu');
		if (menu) {
			menu.style.display = menuOpen ? 'flex' : 'none';
		}
	});

	function closeMobileMenu() {
		menuOpen = false;
		const menu = document.getElementById('mobileMenu');
		if (menu) menu.style.display = 'none';
	}
	window.closeMobileMenu = closeMobileMenu;

	// Intersection Observer for fade-up
	const observer = new IntersectionObserver((entries) => {
		entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
	}, { threshold: 0.1 });
	document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

	// ROI Calculator
	function calcROI() {
		const precio = parseFloat(document.getElementById('precio-drone')?.value) || 0;
		const haDia = parseFloat(document.getElementById('ha-dia')?.value) || 0;
		const precioHa = parseFloat(document.getElementById('precio-ha')?.value) || 0;
		const diasMes = parseFloat(document.getElementById('dias-mes')?.value) || 0;
		const costoOp = parseFloat(document.getElementById('costo-op')?.value) || 0;

		const haMes = haDia * diasMes;
		const ingresosBrutos = haMes * precioHa;
		const gananciaNeta = ingresosBrutos - costoOp;
		const tiempoRecupero = gananciaNeta > 0 ? precio / gananciaNeta : 0;
		const proyeccionAnual = gananciaNeta * 12;

		const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
		set('ganancia-mensual', '$' + formatNum(gananciaNeta));
		set('tiempo-recupero', tiempoRecupero > 0 ? tiempoRecupero.toFixed(1) + ' meses' : '—');
		set('proyeccion-anual', '$' + formatNum(proyeccionAnual));
		set('ingresos-brutos', '$' + formatNum(ingresosBrutos));
		set('ha-mes-desc', formatNum(haMes) + ' ha/mes × $' + formatNum(precioHa) + '/ha');
	}
	window.calcROI = calcROI;

	// Ahorro Calculator
	function calcAhorro() {
		const ha = parseFloat(document.getElementById('hectareas')?.value) || 0;
		const rend = parseFloat(document.getElementById('rendimiento')?.value) || 0;
		const precioGrano = parseFloat(document.getElementById('precio-grano')?.value) || 0;
		const pasadas = parseFloat(document.getElementById('pasadas')?.value) || 0;

		const pctPerdida = pasadas * 0.02;
		const kgPerdidos = ha * rend * pctPerdida;
		const valorPerdida = kgPerdidos * (precioGrano / 1000);
		const ahorroPorHa = ha > 0 ? valorPerdida / ha : 0;

		const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
		set('perdida-evitada', '$' + formatNum(valorPerdida));
		set('kg-evitados', formatNum(kgPerdidos) + ' kg');
		set('ahorro-ha', '$' + formatNum(ahorroPorHa));

		const barMaq = document.getElementById('bar-maq');
		if (barMaq) barMaq.style.width = Math.min(pctPerdida * 100 * 9, 95) + '%';
		const pctMaq = document.getElementById('pct-maq');
		if (pctMaq) pctMaq.textContent = (pctPerdida * 100).toFixed(1) + '%';
	}
	window.calcAhorro = calcAhorro;

	function formatNum(n) {
		if (isNaN(n) || !isFinite(n)) return '0';
		return Math.round(n).toLocaleString('es-AR');
	}

	// Init
	calcROI();
	calcAhorro();
</script>