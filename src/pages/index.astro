<script is:inline>
	// Fonts
	if (!document.querySelector('link[href*="fonts.googleapis.com/css2?family=Syne"]')) {
		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = 'https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap';
		document.head.appendChild(link);
	}

	const heroVideo = document.querySelector('#hero video');
	window.addEventListener('scroll', () => {
		if (heroVideo && window.scrollY < window.innerHeight) {
			heroVideo.style.transform = `translateY(${window.scrollY * 0.15}px) scale(1.05)`;
		}
	}, { passive: true });

	function animateCounters() {
		document.querySelectorAll('[data-count]').forEach((el) => {
			const target = parseInt(el.dataset.count, 10);
			const suffix = el.dataset.suffix || '';
			const duration = 1200;
			const start = performance.now();
			function tick(now) {
				const progress = Math.min((now - start) / duration, 1);
				const eased = 1 - Math.pow(1 - progress, 3);
				el.textContent = Math.round(target * eased) + suffix;
				if (progress < 1) requestAnimationFrame(tick);
			}
			requestAnimationFrame(tick);
		});
	}
	setTimeout(animateCounters, 700);

	// Navbar scroll
	window.addEventListener('scroll', () => {
		const nav = document.getElementById('navbar');
		if (nav) nav.style.background = window.scrollY > 50 ? 'rgba(255,255,255,0.97)' : 'rgba(255,255,255,0.88)';
	});

	// Hamburger
	let menuOpen = false;
	document.getElementById('hamburger')?.addEventListener('click', () => {
		menuOpen = !menuOpen;
		const menu = document.getElementById('mobileMenu');
		if (menu) {
			menu.style.display = menuOpen ? 'flex' : 'none';
		}
	});

	function closeMobileMenu() {
		menuOpen = false;
		const menu = document.getElementById('mobileMenu');
		if (menu) menu.style.display = 'none';
	}
	window.closeMobileMenu = closeMobileMenu;

	// Intersection Observer for fade-up con stagger automático
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((e) => {
			if (e.isIntersecting) {
				const siblings = Array.from(e.target.parentElement.children)
					.filter(el => el.classList.contains('fade-up'));
				const index = siblings.indexOf(e.target);
				e.target.style.transitionDelay = `${Math.min(index * 0.08, 0.5)}s`;
				e.target.classList.add('visible');
				observer.unobserve(e.target); // solo una vez
			}
		});
	}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
	document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

	// ROI Calculator
	function calcROI() {
    const precio = parseFloat(document.getElementById('precio-tarifa').value);
    const haDia = parseFloat(document.getElementById('ha-dia').value);

    document.getElementById('precio-tarifa-display').textContent = `$${precio} USD/ha`;
    document.getElementById('ha-dia-display').textContent = `${haDia} Ha/día`;

    const valorA = precio - 1.56;
    const hectareasRecupero = 36000 / valorA;
    const diasRecupero = hectareasRecupero / haDia;

    document.getElementById('hectareas-recupero').textContent =
        `${Math.round(hectareasRecupero).toLocaleString('es-AR')} Ha`;
    document.getElementById('dias-recupero').textContent =
        `${Math.round(diasRecupero).toLocaleString('es-AR')} días`;
}

// para que arranque calculado apenas carga la página
document.addEventListener('DOMContentLoaded', calcROI);

	window.calcROI = calcROI;

// Ahorro Calculator
	function calcAhorro() {
		const ha = parseFloat(document.getElementById('hectareas')?.value) || 0;
		const rend = parseFloat(document.getElementById('rendimiento')?.value) || 0;
		const precioGrano = parseFloat(document.getElementById('precio-grano')?.value) || 0;

		// OJO: antes esto dependía de un input con id="pasadas" que nunca existió
		// en el HTML. document.getElementById('pasadas') devolvía null, pctPerdida
		// daba 0, y todos los resultados salían en $0 / 0 kg. Se reemplaza por una
		// tasa fija del 2,5%, el mismo número que ya usaba el texto descriptivo viejo.
		const pctPerdida = 0.025;

		const kgPerdidos = ha * rend * pctPerdida;
		const valorPerdida = kgPerdidos * (precioGrano / 1000);

		const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
		set('kg-perdidos', formatNum(kgPerdidos) + ' kg');
		set('monto-equivalente', '$' + formatNum(valorPerdida));
	}
	window.calcAhorro = calcAhorro;

	function formatNum(n) {
		if (isNaN(n) || !isFinite(n)) return '0';
		return Math.round(n).toLocaleString('es-AR');
	}

	// Init
	calcAhorro();
		// Formulario de contacto
	// OJO: el id del <form> es "contact-form" (con guion), no "contactForm".
	// Ese desajuste era lo que impedía que este listener se ejecutara nunca.
	const contactForm = document.getElementById('contact-form');

	contactForm?.addEventListener('submit', async (event) => {
		event.preventDefault();

		const form = event.currentTarget;
		const button = form.querySelector('button[type="submit"]');

		if (!button) return;

		button.disabled = true;
		button.textContent = 'Enviando...';

		try {
			const formData = new FormData(form);

			const response = await fetch('/api/contacto', {
				method: 'POST',
				body: formData,
			});

			const result = await response.json();

			if (response.ok && result.success) {
				showSuccessModal();
				form.reset();
			} else {
				throw new Error(result.message || 'No se pudo enviar la consulta.');
			}
		} catch (error) {
			console.error('Error al enviar el formulario:', error);
			showErrorModal();
		} finally {
			button.disabled = false;
			button.textContent = 'Enviar Consulta →';
		}
	});

	// ===================================================== //
	// MODAL DE CONFIRMACIÓN
	// ===================================================== //

	function setModalState(state) {
		const icon = document.getElementById('modalIcon');
		const title = document.getElementById('modalTitle');
		const text = document.getElementById('modalText');

		if (!icon || !title || !text) return;

		if (state === 'error') {
			icon.className = 'mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[rgba(220,53,69,0.12)]';
			icon.innerHTML = '<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
			title.textContent = 'No pudimos enviar tu consulta';
			text.textContent = 'Intentá nuevamente o escribinos directo por WhatsApp.';
		} else {
			icon.className = 'mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[rgba(37,211,102,0.12)]';
			icon.innerHTML = '<svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52"><circle class="checkmark-circle" cx="26" cy="26" r="24" fill="none"/><path class="checkmark-check" fill="none" d="M14 27l7 7 16-16"/></svg>';
			title.textContent = '¡Consulta enviada!';
			text.textContent = 'Nos comunicaremos con vos a la brevedad para hablar de tu campo.';
		}
	}

	function showSuccessModal() {
		setModalState('success');
		openModal();
	}

	function showErrorModal() {
		setModalState('error');
		openModal();
	}

	function openModal() {
		const modal = document.getElementById('successModal');
		if (!modal) return;
		modal.classList.remove('hidden');
		modal.classList.add('flex');
		document.body.style.overflow = 'hidden';
	}

	function closeSuccessModal() {
		const modal = document.getElementById('successModal');
		if (!modal) return;
		modal.classList.add('hidden');
		modal.classList.remove('flex');
		document.body.style.overflow = '';
	}

	window.closeSuccessModal = closeSuccessModal;

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeSuccessModal();
	});
</script>